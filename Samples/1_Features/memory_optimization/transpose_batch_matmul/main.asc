/*!
 * \file main.asc
 * \brief TransposeBatchMatMul sample using Blaze Gemm framework
 *
 * This sample demonstrates how to use the Blaze Gemm framework (BlockMmad +
 * BlockSchedulerMatmulBasic) to implement a Transpose Batch Matrix Multiplication
 * with the following features:
 *   - PERM_X1: A's batch-M transpose ([0, 1, 2] or [1, 0, 2])
 *   - PERM_X2: B's K-N transpose ([0, 1, 2] or [0, 2, 1])
 *   - BATCH_SPLIT: batch dimension split for parallelism (batchSplitFactor > 1)
 * 
 * Computation: Y[m, batch, n] = sum_k(A[?, ?, k] * B[batch, ?, k])
 * 
 * A layout depends on PERM_X1:
 *   - PERM_X1=0 ([0, 1, 2]): A[batch, m, k]
 *   - PERM_X1=1 ([1, 0, 2]): A[m, batch, k] (batch-M swapped)
 * 
 * B layout depends on PERM_X2:
 *   - PERM_X2=0 ([0, 1, 2]): B[batch, k, n]
 *   - PERM_X2=1 ([0, 2, 1]): B[batch, n, k] (K-N swapped)
 * 
 * Output Y is always [m, batch, n] (perm_y = [1, 0, 2]).
 * When batchSplitFactor > 1, output is reshaped to [bsf, m, innerBatch * n].
 */

#include <iostream>
#include <vector>
#include <cmath>
#include <memory>
#include <random>
#include <iomanip>
#include <algorithm>
#include <cstring>
#include <cstdint>
#include <filesystem>
#include <sys/stat.h>
#include <fstream>
#include <fcntl.h>
#include <unistd.h>

#include "acl/acl.h"
#include "kernel_basic_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "include/tensor_api/tensor.h"

#define ERROR_LOG(fmt, args...) fprintf(stdout, "[ERROR]  " fmt "\n", ##args)
#define CHECK_COND(cond, message, return_expr)              \
    do {                                                    \
        if (!(cond)) {                                      \
            std::cerr << "ERROR: " << message << std::endl; \
            return_expr;                                    \
        }                                                   \
    } while (0)

namespace AscendC::Te {
static constexpr bool transA = false;
static constexpr bool transB = false;
template <typename T>
using MakeLayoutAL1 =
    AscendC::Std::conditional_t<transA, AscendC::Te::FrameLayoutFormat<AscendC::Te::ZNLayoutPtn, AscendC::Te::LayoutTraitDefault<T>>, AscendC::Te::FrameLayoutFormat<AscendC::Te::NZLayoutPtn, AscendC::Te::LayoutTraitDefault<T>>>;
template <typename T>
using MakeLayoutBL1 =
    AscendC::Std::conditional_t<transB, AscendC::Te::FrameLayoutFormat<AscendC::Te::ZNLayoutPtn, AscendC::Te::LayoutTraitDefault<T>>, AscendC::Te::FrameLayoutFormat<AscendC::Te::NZLayoutPtn, AscendC::Te::LayoutTraitDefault<T>>>;
} // namespace AscendC::Te

namespace tbmm {

static constexpr int32_t L0C_C0 = 16;
static constexpr uint64_t PERM_X1_0_1_2 = 0;
static constexpr uint64_t PERM_X1_1_0_2 = 1;
static constexpr uint16_t ZERO_FLAG = 0;
static constexpr uint16_t FIRST_FLAG = 1;
static constexpr bool TRANS_B_FALSE = false;
static constexpr bool TRANS_B_TRUE = true;

template <uint64_t PERM_X1, bool TRANS_B>
struct KernelTraits {
    static constexpr bool transBatchA = (PERM_X1 == PERM_X1_1_0_2);
    static constexpr bool transB = TRANS_B;
};

/**
 * @brief Ceiling division for integer arithmetic
 */
__aicore__ inline uint64_t CeilDiv(uint64_t a, uint64_t b)
{
    if (b == 0) {
        return a;
    }
    return (a + b - 1) / b;
}


template <typename T>
__aicore__ inline auto MakeNDBatchLayout(
    uint64_t batch, uint64_t row, uint64_t col, uint64_t batchStride, uint64_t colStride)
{
    return AscendC::Te::MakePatternLayout<
            AscendC::Te::NDLayoutPtn, AscendC::Te::LayoutTrait<T, AscendC::Std::Int<AscendC::Te::C0_ELEMENT<T>>>>(
            AscendC::Te::MakeShape(batch, AscendC::Te::MakeShape(row, col)),
            AscendC::Te::MakeStride(batchStride, AscendC::Te::MakeStride(colStride, AscendC::Te::_1{})));
}

template <typename T, uint64_t PERM_X1, bool TRANS_B>
__global__ __aicore__ void TbmmKernel(GM_ADDR aGm, GM_ADDR bGm, GM_ADDR cGm, 
                                      uint32_t m, uint32_t n, uint32_t k, uint32_t batch,
                                      uint32_t batchSplitFactor)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);

    uint32_t kL1 = 256;
    uint32_t baseM = 128;
    uint32_t baseN = 128;
    uint32_t baseK = 64;

    using Traits = KernelTraits<PERM_X1, TRANS_B>;
    constexpr bool transBatchA = Traits::transBatchA;
    constexpr bool transB = Traits::transB;

    int64_t curBlockIdx = AscendC::GetBlockIdx();
    int64_t blockNum = AscendC::GetBlockNum();

    uint64_t mBlockNums = tbmm::CeilDiv(m, baseM);
    uint64_t nBlockNums = tbmm::CeilDiv(n, baseN);
    uint64_t mnBlockNums = mBlockNums * nBlockNums;
    uint64_t totalBlockNums = mnBlockNums * batch;

    uint64_t tailM = m - (mBlockNums - 1) * baseM;
    uint64_t tailN = n - (nBlockNums - 1) * baseN;

    uint64_t kL1BlockNums = tbmm::CeilDiv(k, kL1);
    uint64_t tailK = k - (kL1BlockNums - 1) * kL1;

    constexpr uint64_t HALF_L0_SIZE = 64 * 1024 / 2;

    uint64_t batchStrideA = transBatchA ? k : m * k;
    uint64_t mStrideA = transBatchA ? batch * k : k;
    auto layoutA = MakeNDBatchLayout<T>(batch, m, k, batchStrideA, mStrideA);

    using BGmLayoutPtn = AscendC::Std::conditional_t<transB, AscendC::Te::DNExtLayoutPtn, AscendC::Te::NDExtLayoutPtn>;
    using MakeBLayout = AscendC::Te::FrameLayoutFormat<BGmLayoutPtn, AscendC::Std::Int<AscendC::Te::C0_ELEMENT<T>>>;
    auto layoutB = MakeBLayout{}(batch, k, n);

    auto layoutC = MakeNDBatchLayout<T>(batch, m, n, n, batch * n);

    uint64_t innerBatch = batch / batchSplitFactor;
    auto splitBatchLayoutC = AscendC::Te::MakePatternLayout<
        AscendC::Te::NDLayoutPtn, AscendC::Te::LayoutTrait<T, AscendC::Std::Int<AscendC::Te::C0_ELEMENT<T>>>>(
        AscendC::Te::MakeShape(batchSplitFactor, innerBatch, AscendC::Te::MakeShape(m, n)),
        AscendC::Te::MakeStride(
            m * innerBatch * n, n, AscendC::Te::MakeStride(innerBatch * n, AscendC::Te::_1{})));

    auto gmA = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr<AscendC::Te::Location::GM>(reinterpret_cast<__gm__ T*>(aGm)), layoutA);
    auto gmB = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr<AscendC::Te::Location::GM>(reinterpret_cast<__gm__ T*>(bGm)), layoutB);
    auto gmC = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr<AscendC::Te::Location::GM>(reinterpret_cast<__gm__ T*>(cGm)), layoutC);
    auto splitBatchGmC = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr<AscendC::Te::Location::GM>(reinterpret_cast<__gm__ T*>(cGm)), splitBatchLayoutC);

    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(tbmm::ZERO_FLAG);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(tbmm::FIRST_FLAG);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(tbmm::ZERO_FLAG);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(tbmm::FIRST_FLAG);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(tbmm::ZERO_FLAG);

    uint64_t l0PingPong_ = 0;
    uint64_t l1PingPong_ = 0;
    uint64_t l1AOffset[2] = {0UL};
    uint64_t l1BOffset[2] = {0UL};

    for (uint64_t blockIdx = curBlockIdx; blockIdx < totalBlockNums; blockIdx += blockNum) {
        uint64_t curBatchIdx = blockIdx / mnBlockNums;
        uint64_t mnIdx = blockIdx % mnBlockNums;
        uint64_t mBlockIdx = mnIdx / nBlockNums;
        uint64_t nBlockIdx = mnIdx % nBlockNums;

        int64_t shapeM = mBlockIdx == (mBlockNums - 1) ? tailM : baseM;
        int64_t shapeN = nBlockIdx == (nBlockNums - 1) ? tailN : baseN;

        auto subGmA = gmA.Slice(
            AscendC::MakeCoord(curBatchIdx, AscendC::MakeCoord(mBlockIdx * baseM, 0L)),
            AscendC::MakeShape(1L, AscendC::MakeShape(shapeM, k))
        );
        auto gmBlockA = AscendC::Te::Squeeze<0>(subGmA);
        auto subGmB = gmB.Slice(
            AscendC::MakeCoord(curBatchIdx, AscendC::MakeCoord(0L, nBlockIdx * baseN)),
            AscendC::MakeShape(1L, AscendC::MakeShape(k, shapeN))
        );
        auto gmBlockB = AscendC::Te::Squeeze<0>(subGmB);

        auto l0LayoutC = AscendC::Te::MakeFrameLayout<AscendC::Te::NZLayoutPtn, AscendC::Std::Int<tbmm::L0C_C0>>(shapeM, shapeN);
        auto l0BlockC = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr<AscendC::Te::Location::L0C, float>(0), l0LayoutC);

        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(tbmm::ZERO_FLAG);
        for (uint64_t iter0 = 0; iter0 < kL1BlockNums; ++iter0) {
            uint64_t l1BufIdx = l1PingPong_ & 1;
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BufIdx);

            auto curK1 = (iter0 + 1 == kL1BlockNums) ? tailK : kL1;

            uint64_t l1ASize = baseM * kL1 * sizeof(T);
            uint64_t l1Base = (AscendC::TOTAL_L1_SIZE >> 1) * l1BufIdx;
            l1AOffset[l1BufIdx] = l1Base;
            l1BOffset[l1BufIdx] = l1Base + l1ASize;

            auto copyGM2L1 = AscendC::Te::MakeCopy(AscendC::Te::CopyGM2L1{});
            auto l1LayoutA = AscendC::Te::MakeLayoutAL1<T>{}(shapeM, curK1);
            auto l1BlockA = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr<AscendC::Te::Location::L1, T>(l1AOffset[l1BufIdx]), l1LayoutA);
            auto gmTileA =
                gmBlockA.Slice(AscendC::MakeCoord(0, iter0 * kL1), AscendC::MakeShape(shapeM, curK1));
            AscendC::Te::Copy(copyGM2L1, l1BlockA, gmTileA);

            auto l1LayoutB = AscendC::Te::MakeLayoutBL1<T>{}(curK1, shapeN);
            auto l1BlockB = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr<AscendC::Te::Location::L1, T>(l1BOffset[l1BufIdx]), l1LayoutB);
            auto gmTileB =
                gmBlockB.Slice(AscendC::MakeCoord(iter0 * kL1, 0), AscendC::MakeShape(curK1, shapeN));
            AscendC::Te::Copy(copyGM2L1, l1BlockB, gmTileB);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BufIdx);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BufIdx);

            uint64_t kL0IterNum = tbmm::CeilDiv(curK1, baseK);
            uint64_t tailK0 = curK1 - (kL0IterNum - 1) * baseK;

            for (uint16_t iter1 = 0; iter1 < kL0IterNum; ++iter1) {
                uint64_t l0BufIdx = l0PingPong_ & 1;
                uint64_t l0Offset = HALF_L0_SIZE * l0BufIdx;
                uint64_t curK0 = (iter1 + 1 == kL0IterNum) ? tailK0 : baseK;

                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BufIdx);

                auto copyL12L0A = AscendC::Te::MakeCopy(AscendC::Te::CopyL12L0A{});
                auto copyL12L0B = AscendC::Te::MakeCopy(AscendC::Te::CopyL12L0B{});
                auto l0LayoutA = AscendC::Te::MakeFrameLayout<AscendC::Te::NZLayoutPtn, AscendC::Te::LayoutTraitDefault<T>>(shapeM, curK0);
                auto l0BlockA = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr<AscendC::Te::Location::L0A, T>(l0Offset), l0LayoutA);
                auto l1TileA =
                    l1BlockA.Slice(AscendC::MakeCoord(0, iter1 * baseK), AscendC::MakeShape(shapeM, curK0));
                AscendC::Te::Copy(copyL12L0A, l0BlockA, l1TileA);

                auto l0LayoutB = AscendC::Te::MakeFrameLayout<AscendC::Te::ZNLayoutPtn, AscendC::Te::LayoutTraitDefault<T>>(curK0, shapeN);
                auto l0BlockB = AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr<AscendC::Te::Location::L0B, T>(l0Offset), l0LayoutB);
                auto l1TileB =
                    l1BlockB.Slice(AscendC::MakeCoord(iter1 * baseK, 0), AscendC::MakeShape(curK0, shapeN));
                AscendC::Te::Copy(copyL12L0B, l0BlockB, l1TileB);

                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0BufIdx);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0BufIdx);

                AscendC::Te::MmadParams para;
                para.cmatrixInitVal = (iter1 == 0 && iter0 == 0);
                para.m = shapeM;
                para.n = shapeN;
                para.k = curK0;

                auto MadOp = AscendC::Te::MakeMmad(AscendC::Te::MmadOperation{}, AscendC::Te::MmadTraitDefault{});
                AscendC::Te::Mmad(MadOp.with(para), l0BlockC, l0BlockA, l0BlockB);

                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BufIdx);
                l0PingPong_++;
            }
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BufIdx);
            l1PingPong_++;
        }

        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(tbmm::ZERO_FLAG);
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(tbmm::ZERO_FLAG);

        auto copyL0C2GM = AscendC::Te::MakeCopy(AscendC::Te::CopyL0C2GM{});
        if (batchSplitFactor > 1) {
            auto outerBatchIdx = curBatchIdx / innerBatch;
            auto innerBatchIdx = curBatchIdx % innerBatch;
            auto splitBatchSubGmC = splitBatchGmC.Slice(
                AscendC::MakeCoord(
                    outerBatchIdx, innerBatchIdx, AscendC::MakeCoord(mBlockIdx * baseM, nBlockIdx * baseN)),
                AscendC::MakeShape(
                    AscendC::Te::_1{}, AscendC::Te::_1{}, AscendC::MakeShape(shapeM, shapeN)));
            auto splitBatchGmBlockC = AscendC::Te::Squeeze<0, 1>(splitBatchSubGmC);
            AscendC::Te::Copy(copyL0C2GM, splitBatchGmBlockC, l0BlockC);
        } else {
            auto subGmC = gmC.Slice(
                AscendC::MakeCoord(curBatchIdx, AscendC::MakeCoord(mBlockIdx * baseM, nBlockIdx * baseN)),
                AscendC::MakeShape(1L, AscendC::MakeShape(shapeM, shapeN)));
            auto gmBlockC = AscendC::Te::Squeeze<0>(subGmC);
            AscendC::Te::Copy(copyL0C2GM, gmBlockC, l0BlockC);
        }

        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(tbmm::ZERO_FLAG);
    }

    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(tbmm::ZERO_FLAG);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(tbmm::ZERO_FLAG);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(tbmm::FIRST_FLAG);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(tbmm::FIRST_FLAG);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(tbmm::ZERO_FLAG);
}

} // namespace tbmm

// Print command-line usage help
void printUsage(const std::string& programName)
{
    std::cerr << "Usage: " << programName << " m k n batch [perm_x1] [perm_x2] [batch_split_factor]" << std::endl;
    std::cerr << "Args: " << std::endl;
    std::cerr << "  m: row of matrix A (M dimension)" << std::endl;
    std::cerr << "  k: col of matrix A / row of matrix B (k dimension)" << std::endl;
    std::cerr << "  n: col of matrix B (N dimension)" << std::endl;
    std::cerr << "  batch : batch dimension" << std::endl;
    std::cerr << "  perm_x1 : 0=[0, 1, 2] (no transpose), 1=[1, 0, 2] (batch-M swap), default=1" << std::endl;
    std::cerr << "  perm_x2 : 0=[0, 1, 2] (no transpose), 1=[0, 2, 1] (B K-N swap), default=0" << std::endl;
    std::cerr << "  batch_split_factor : 1=no split, >1=split batch, default=1" << std::endl;
    std::cerr << "Example: " << programName << " 32 512 128 16 1 0 1" << std::endl;
    std::cerr << "Example: " << programName << " 32 512 128 16 1 0 4" << std::endl;
}

// Brief parses and validates command-line arguments
void parseArguments(int argc, char* argv[], int& m, int& k, int& n, int& batch,
                    int& perm_x1, int& perm_x2, int& batch_split_factor)
{
    if (argc >= 2 && (std::string(argv[1]) == "--help" || std::string(argv[1]) == "-h")) {
        printUsage(argv[0]);
        exit(1);
    }
    if (argc < 5) {
        throw std::invalid_argument("ERROR: Lacks Arguments");
    }
    try {
        m = std::stoi(argv[1]);
        k = std::stoi(argv[2]);
        n = std::stoi(argv[3]);
        batch = std::stoi(argv[4]);
        perm_x1 = (argc > 5) ? std::stoi(argv[5]) : 1;
        perm_x2 = (argc > 6) ? std::stoi(argv[6]) : 0;
        batch_split_factor = (argc > 7) ? std::stoi(argv[7]) : 1;
    } catch (const std::invalid_argument& e) {
        throw std::invalid_argument("ERROR: m k n must be Integer");
    }

    if (m <= 0 || k <= 0 || n <= 0 || batch <= 0) {
        throw std::invalid_argument("ERROR: m k n batch must be positive");
    }

    if (perm_x1 != 0 && perm_x1 !=1) {
        throw std::invalid_argument("ERROR: perm_x1 must be 0 or 1");
    }

    if (perm_x2 != 0 && perm_x2 !=1) {
        throw std::invalid_argument("ERROR: perm_x2 must be 0 or 1");
    }

    if (batch_split_factor < 1 || batch % batch_split_factor != 0) {
        throw std::invalid_argument("ERROR: batch_split_factor must be >= 1 and divide batch");
    }
}

namespace tool {
    inline bool ReadFile(const std::string& filePath, size_t& fileSize, void* buffer, size_t bufferSize);
    inline bool WriteFile(const std::string& filePath, const void* buffer, size_t size);
    float Bf16ToFloat(uint16_t h);
} // namespace tool
using namespace tool;

/**
 * @brief Main function - host-side setup and execution
 *
 * This function:
 * 1. Parses command line arguments
 * 2. Initializes Ascend Computing Language (ACL) resources
 * 3. Allocates and initializes host/device memory
 * 4. Launches the kernel
 * 5. Verifies results against CPU reference
 * 6. Cleans up resources
 */
int main(int argc, char* argv[])
{
    int m, k, n, batch, permX1, permX2, batchSplitFactor;
    try {
        parseArguments(argc, argv, m, k, n, batch, permX1, permX2, batchSplitFactor);
    } catch (const std::exception& e) {
        std::cerr << e.what() << std::endl;
        printUsage(argv[0]);
        return 1;
    }

    // Initialize ACL (Ascend Computing Language) resources
    int32_t deviceId = 0;
    aclrtStream stream;
    auto ret = aclInit(nullptr);
    CHECK_COND(ret == ACL_SUCCESS, "aclInit failed.", return 1);
    ret = aclrtSetDevice(deviceId);
    CHECK_COND(ret == ACL_SUCCESS, "aclrtSetDevice failed.", return 1);
    ret = aclrtCreateStream(&stream);
    CHECK_COND(ret == ACL_SUCCESS, "aclrtCreateStream failed.", return 1);

    uint64_t aElementCount = static_cast<uint64_t>(m) * batch * k;
    uint64_t bElementCount = static_cast<uint64_t>(batch) * k * n;
    uint64_t cElementCount = (batchSplitFactor > 1)
        ? static_cast<uint64_t>(batchSplitFactor) * m * (batch / batchSplitFactor) * n
        : static_cast<uint64_t>(m) * batch * n;

    std::vector<uint16_t> hostInput(aElementCount, 0);
    std::vector<uint16_t> hostWeight(bElementCount, 0);
    std::vector<uint16_t> hostOutput(cElementCount, 0);

    auto sizeInput = aElementCount * sizeof(uint16_t);
    auto sizeWeight = bElementCount * sizeof(uint16_t);
    auto sizeOutput = cElementCount * sizeof(uint16_t);
    
    std::string cmd = "python3 gen_data.py " + std::to_string(m) + " " + std::to_string(k) + " " + std::to_string(n)
                        + " " + std::to_string(batch) + " " + std::to_string(permX1)
                        + " " + std::to_string(permX2) + " " + std::to_string(batchSplitFactor);
    if (system(cmd.c_str()) != 0) {
        std::cerr << "ERROR: Data generation failed." << std::endl;
        return 1;
    }

    std::string baseDir = std::filesystem::current_path();
    std::string inputDir = baseDir + "/input";
    std::string outputDir = baseDir + "/output";
    size_t actualSizeInput = 0;
    size_t actualSizeWeight = 0;
    if (!ReadFile(inputDir + "/input_a.bin", actualSizeInput, hostInput.data(), sizeInput)) {
        ERROR_LOG("failed to read input_a.bin");
        return 1;
    }
    if (actualSizeInput != sizeInput) {
        ERROR_LOG("input_a.bin size mismatch: expected %zu, got %zu", sizeInput, actualSizeInput);
        return 1;
    }
    if (!ReadFile(inputDir + "/input_b.bin", actualSizeWeight, hostWeight.data(), sizeWeight)) {
        ERROR_LOG("failed to read input_b.bin");
        return 1;
    }
    if (actualSizeWeight != sizeWeight) {
        ERROR_LOG("input_b.bin size mismatch: expected %zu, got %zu", sizeWeight, actualSizeWeight);
        return 1;
    }

    uint8_t *deviceInput = nullptr;
    uint8_t *deviceWeight = nullptr;
    uint8_t *deviceOutput = nullptr;
    std::unique_ptr<void, aclError (*)(void*)> deviceInputPtr(deviceInput, aclrtFree);
    ret = aclrtMalloc((void**)&deviceInput, sizeInput, ACL_MEM_MALLOC_HUGE_FIRST);
    CHECK_COND(ret == ACL_SUCCESS, "aclrtMalloc deviceInput failed.", return 1);

    std::unique_ptr<void, aclError (*)(void*)> deviceWeightPtr(deviceWeight, aclrtFree);
    ret = aclrtMalloc((void**)&deviceWeight, sizeWeight, ACL_MEM_MALLOC_HUGE_FIRST);
    CHECK_COND(ret == ACL_SUCCESS, "aclrtMalloc deviceWeight failed.", return 1);

    std::unique_ptr<void, aclError (*)(void*)> deviceOutputPtr(deviceOutput, aclrtFree);
    ret = aclrtMalloc((void**)&deviceOutput, sizeOutput, ACL_MEM_MALLOC_HUGE_FIRST);
    CHECK_COND(ret == ACL_SUCCESS, "aclrtMalloc deviceOutput failed.", return 1);

    ret = aclrtMemcpy(deviceInput, sizeInput, hostInput.data(), sizeInput, ACL_MEMCPY_HOST_TO_DEVICE);
    CHECK_COND(ret == ACL_SUCCESS, "aclrtMemcpy deviceInput failed.", return 1);
    ret = aclrtMemcpy(deviceWeight, sizeWeight, hostWeight.data(), sizeWeight, ACL_MEMCPY_HOST_TO_DEVICE);
    CHECK_COND(ret == ACL_SUCCESS, "aclrtMemcpy deviceWeight failed.", return 1);

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    CHECK_COND(ascendcPlatform != nullptr, "get ascendcPlatform failed.", return 1);
    uint32_t numBlocks = ascendcPlatform->GetCoreNumAic(); // Number of AI cores

    if (permX1 == 0 && permX2 == 0) {
        tbmm::TbmmKernel<bfloat16_t, tbmm::PERM_X1_0_1_2, tbmm::TRANS_B_FALSE>
        <<<numBlocks, nullptr, stream>>>(deviceInput, deviceWeight, deviceOutput, m, n, k, batch, batchSplitFactor);
    } else if (permX1 == 0 && permX2 == 1) {
        tbmm::TbmmKernel<bfloat16_t, tbmm::PERM_X1_0_1_2, tbmm::TRANS_B_TRUE>
        <<<numBlocks, nullptr, stream>>>(deviceInput, deviceWeight, deviceOutput, m, n, k, batch, batchSplitFactor);
    } else if (permX1 == 1 && permX2 == 0) {
        tbmm::TbmmKernel<bfloat16_t, tbmm::PERM_X1_1_0_2, tbmm::TRANS_B_FALSE>
        <<<numBlocks, nullptr, stream>>>(deviceInput, deviceWeight, deviceOutput, m, n, k, batch, batchSplitFactor);
    } else if (permX1 == 1 && permX2 == 1) {
        tbmm::TbmmKernel<bfloat16_t, tbmm::PERM_X1_1_0_2, tbmm::TRANS_B_TRUE>
        <<<numBlocks, nullptr, stream>>>(deviceInput, deviceWeight, deviceOutput, m, n, k, batch, batchSplitFactor);
    }

    ret = aclrtSynchronizeStream(stream);
    CHECK_COND(ret == ACL_SUCCESS, "aclrtSynchronizeStream failed.", return 1);

    ret = aclrtMemcpy(hostOutput.data(), sizeOutput, deviceOutput, sizeOutput, ACL_MEMCPY_DEVICE_TO_HOST);
    CHECK_COND(ret == ACL_SUCCESS, "aclrtMemcpy deviceOutput failed.", return 1);

    WriteFile(outputDir + "/npu_out.bin", hostOutput.data(), sizeOutput);

    uint64_t outRows = (batchSplitFactor > 1) ? batchSplitFactor : m;
    uint64_t outCols = (batchSplitFactor > 1) ? (m * (batch / batchSplitFactor) * n) : batch * n;

    cmd = "python3 verify_result.py " + std::to_string(outRows) + " " + std::to_string(outCols);
    int verifyRet = std::system(cmd.c_str());

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return (verifyRet == 0) ? 0 : 1;
}

namespace tool {
/**
 * @brief Fill a vector with random data
 *
 * @tparam T Data type (integral or floating point)
 * @param data Vector to fill
 * @param min Minimum value
 * @param max Maximum value
 */
template <typename T>
void FillRandomData(std::vector<T>& data, T min, T max)
{
    std::random_device rd;
    std::mt19937 gen(rd());
    if constexpr (std::is_integral<T>::value) {
        std::uniform_int_distribution<T> dist(min, max);
        for (auto& elem : data)
            elem = dist(gen);
    } else if constexpr (std::is_floating_point<T>::value) {
        std::uniform_real_distribution<T> dist(min, max);
        for (auto& elem : data)
            elem = dist(gen);
    }
}

/**
 * @brief Compute matrix multiplication on CPU as golden reference
 *
 * @tparam T Data type
 * @param m Rows of A
 * @param k Columns of A / Rows of B
 * @param n Columns of B
 * @param hostInput Matrix A
 * @param hostWeight Matrix B
 * @param goldenOutput Output matrix C (reference)
 */
template <typename T>
void ComputeGolden(
    int m, int k, int n, std::vector<T>& hostInput, std::vector<T>& hostWeight, std::vector<T>& goldenOutput)
{
    for (uint32_t row = 0; row < m; ++row) {
        for (uint32_t col = 0; col < n; ++col) {
            size_t offsetGolden = row * n + col;
            T sum = 0;
            for (uint32_t iter = 0; iter < k; ++iter) {
                size_t offsetInput = row * k + iter;
                size_t offsetWeight = iter * n + col;
                sum += hostInput[offsetInput] * hostWeight[offsetWeight];
            }
            goldenOutput[offsetGolden] = sum;
        }
    }
}

/**
 * @brief Compare kernel output with golden reference
 *
 * @tparam T Data type
 * @param hostOutput Kernel output
 * @param goldenOutput CPU reference
 * @return std::vector<uint64_t> Indices where values differ beyond tolerance
 */
template <typename T>
std::vector<uint64_t> Compare(std::vector<T>& hostOutput, std::vector<T>& goldenOutput)
{
    std::vector<uint64_t> errorIndices;
    const float rtol = 1.0f / 256; // Relative tolerance for float comparison
    for (uint64_t i = 0; i < hostOutput.size(); ++i) {
        T actualValue = hostOutput[i];
        T expectValue = goldenOutput[i];
        T diff = std::fabs(actualValue - expectValue);
        if (diff > rtol * std::max(1.0f, std::fabs(expectValue))) {
            errorIndices.push_back(i);
        }
    }
    return errorIndices;
}

/**
 * @brief Convert a 16-bit brain floating-point (bfloat16) value to a 32-bit float
 * @param h 16-bit bfloat16 value stored in uint16_t format
 * @return The converted 32-bit floating-point value
 */
float Bf16ToFloat(uint16_t h)
{
    uint32_t sign = (h & 0x8000U) ? 0x80000000U : 0x00000000U;
    uint32_t exponent = (h >> 7) & 0x00FFU;
    uint32_t mantissa = h & 0x007FU;
    uint32_t f_bits = sign | (exponent << 23) | (mantissa << (23 - 7));
    return *reinterpret_cast<float*>(&f_bits);
}

/**
 * @brief Convert a 32-bit float to a 16-bit brain floating-point (bfloat16) value
 * @param f 32-bit floating-point value to convert
 * @return The converted 16-bit bfloat16 value stored in uint16_t format (truncated rounding)
 */
uint16_t FloatToBf16(float f)
{
    uint32_t f_bits;
    std::memcpy(&f_bits, &f, sizeof(f_bits));

    // Extract the high 16 bits (simple truncation)
    return static_cast<uint16_t>(f_bits >> 16);
}

inline bool ReadFile(const std::string& filePath, size_t& fileSize, void* buffer, size_t bufferSize)
{
    struct stat sBuf;
    int fileStatus = stat(filePath.data(), &sBuf);
    if (fileStatus == -1) {
        ERROR_LOG("failed to get file");
        return false;
    }
    if (S_ISREG(sBuf.st_mode) == 0) {
        ERROR_LOG("%s is not a file, please enter a file", filePath.c_str());
        return false;
    }

    std::ifstream file;
    file.open(filePath, std::ios::binary);
    if (!file.is_open()) {
        ERROR_LOG("Open file failed. path = %s", filePath.c_str());
        return false;
    }

    std::filebuf* buf = file.rdbuf();
    size_t size = buf->pubseekoff(0, std::ios::end, std::ios::in);
    if (size == 0) {
        ERROR_LOG("file size is 0");
        file.close();
        return false;
    }
    if (size > bufferSize) {
        ERROR_LOG("file size is larger than buffer size");
        file.close();
        return false;
    }
    buf->pubseekpos(0, std::ios::in);
    buf->sgetn(static_cast<char*>(buffer), size);
    fileSize = size;
    file.close();
    return true;
}

/**
 * @brief Write data to file
 * @param [in] filePath: file path
 * @param [in] buffer: data to write to file
 * @param [in] size: size to write
 * @return write result
 */
inline bool WriteFile(const std::string& filePath, const void* buffer, size_t size)
{
    if (buffer == nullptr) {
        ERROR_LOG("Write file failed. buffer is nullptr");
        return false;
    }

    int fd = open(filePath.c_str(), O_RDWR | O_CREAT | O_TRUNC, S_IRUSR | S_IWRITE);
    if (fd < 0) {
        ERROR_LOG("Open file failed. path = %s", filePath.c_str());
        return false;
    }

    size_t writeSize = write(fd, buffer, size);
    (void)close(fd);
    if (writeSize != size) {
        ERROR_LOG("Write file Failed.");
        return false;
    }

    return true;
}

} // namespace tool
