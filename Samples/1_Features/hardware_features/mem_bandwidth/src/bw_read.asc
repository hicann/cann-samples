/*!
 * \file bw_read.asc
 * \brief 纯读带宽测试（只搬入，不计算、不搬出），TPipe + TQue + DoubleBuffer。
 *
 * 1 路输入 x（float 随机数），kernel 只把数据从 GM 搬入 UB（MTE2），随即回收 buffer：
 * CopyIn(MTE2 搬入 UB) → DeQue/FreeTensor 回收，不做任何计算与搬出。
 * buffer 数（2 即 DoubleBuffer，与 tile 成对扫描）让相邻 tile 的搬运首尾重叠，吃满 MTE2。全核参与（数据量被核数整除，
 * 各核 blockFactor 一致；核内再切 UB tile + UB 尾块）。
 * UB tile 大小（即 pipe.InitBuffer 分配给每个 buffer 的字节数）与 buffer 数成对扫描：命令行同时给 <queBytes> <bufNum>
 * 时只跑该组合，否则按下标成对扫 DEFAULT_QUE_BYTES_LIST 与 DEFAULT_BUFFER_NUM_LIST。
 * 耗时用 msprof 采集 Task Duration / aiv_mte2_time，带宽 = 读 DATA_BYTES / 时间。
 *
 * CLI: bw_read [queBytes bufNum]（两参数须同时给出，或都不给以扫默认列表）
 */

#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include "bw_common.h"

// ---------------------------------------------------------------------------
// Kernel：只把 x 从 GM 搬入 UB（MTE2），随即回收 buffer，不计算、不搬出
// ---------------------------------------------------------------------------
using namespace AscendC;

class KernelBwRead {
public:
    __aicore__ inline KernelBwRead()
    {}

    __aicore__ inline void Init(
        GM_ADDR x, int64_t blockFactor, int64_t loops, uint32_t tailCount, uint32_t ubFactor, uint32_t bufNum)
    {
        loops_ = loops;
        tailCount_ = tailCount;
        ubFactor_ = ubFactor;

        xGm_.SetGlobalBuffer((__gm__ float*)x + blockFactor * GetBlockIdx(), blockFactor);
        pipe_.InitBuffer(inQue_, bufNum, ubFactor * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        int64_t offset = 0;
        for (int64_t i = 0; i < loops_ - 1; ++i) {
            CopyIn(offset, ubFactor_);
            Drain();
            offset += ubFactor_;
        }
        CopyIn(offset, tailCount_);
        Drain();
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, uint32_t count)
    {
        LocalTensor<float> xLocal = inQue_.AllocTensor<float>();
        DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        DataCopyPadExtParams<float> padParams{false, 0, 0, 0};
        DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        inQue_.EnQue(xLocal);
    }

    __aicore__ inline void Drain()
    {
        LocalTensor<float> xLocal = inQue_.DeQue<float>();
        inQue_.FreeTensor(xLocal);
    }

    TPipe pipe_;
    TQue<TPosition::VECIN, 1> inQue_;
    GlobalTensor<float> xGm_;
    int64_t loops_ = 0;
    uint32_t tailCount_ = 0;
    uint32_t ubFactor_ = 0;
};

__global__ __aicore__ __vector__ void bw_read_kernel(
    GM_ADDR x, int64_t blockFactor, int64_t loops, uint32_t tailCount, uint32_t ubFactor, uint32_t bufNum)
{
    KernelBwRead op;
    op.Init(x, blockFactor, loops, tailCount, ubFactor, bufNum);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host
// ---------------------------------------------------------------------------
int main(int argc, char** argv)
{
    // queBytes / bufNum 成对：命令行须同时给出 <queBytes> <bufNum> 只跑这一组；不给参数则按下标
    // 扫 DEFAULT_QUE_BYTES_LIST 与 DEFAULT_BUFFER_NUM_LIST。只给一个参数视为用法错误。
    std::vector<int64_t> queBytesList;
    std::vector<int32_t> bufNumList;
    if (argc == 1) {
        int n = sizeof(DEFAULT_QUE_BYTES_LIST) / sizeof(DEFAULT_QUE_BYTES_LIST[0]);
        for (int i = 0; i < n; ++i) {
            queBytesList.push_back(DEFAULT_QUE_BYTES_LIST[i]);
            bufNumList.push_back(DEFAULT_BUFFER_NUM_LIST[i]);
        }
    } else if (argc == 3) {
        queBytesList.push_back(std::atoll(argv[1]));
        bufNumList.push_back(std::atoi(argv[2]));
    } else {
        std::cerr << "用法: " << argv[0] << " [queBytes bufNum]（两参数须同时给出，或都不给以扫默认列表）" << std::endl;
        return 1;
    }

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = static_cast<int64_t>(ascendcPlatform->GetCoreNumAiv());
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);

    int64_t elems = DATA_BYTES / static_cast<int64_t>(sizeof(float));

    if (elems % coreNum != 0) {
        std::cerr << "数据量 " << elems << " floats 不能被核数 " << coreNum << " 整除，请调整 DATA_BYTES" << std::endl;
        return 1;
    }
    int64_t blockFactor = elems / coreNum;

    // 生成随机数（避免全零内存被压缩、读出虚高带宽）。
    std::vector<float> hData(elems);
    std::mt19937 gen(12345);
    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
    for (int64_t i = 0; i < elems; ++i) {
        hData[i] = dist(gen);
    }

    constexpr int64_t DATABLOCK = 32;
    constexpr int64_t QUEUE_NUM = 1; // 只有 inQue_ 一条队列
    int ret = 0;

    for (size_t idx = 0; idx < queBytesList.size(); ++idx) {
        int64_t queBytes = queBytesList[idx];
        int32_t bufNum = bufNumList[idx];
        if (queBytes <= 0 || queBytes % DATABLOCK != 0) {
            std::cerr << "queBytes (" << queBytes << ") 必须是 32B 的正整数倍，已跳过" << std::endl;
            ret = 1;
            continue;
        }
        if (bufNum < 1) {
            std::cerr << "bufNum (" << bufNum << ") 必须 ≥ 1，已跳过" << std::endl;
            ret = 1;
            continue;
        }
        // UB 预算：每条队列占 bufNum × queBytes，本样例队列数见 QUEUE_NUM。
        int64_t ubNeeded = queBytes * bufNum * QUEUE_NUM;
        if (ubNeeded > static_cast<int64_t>(ubSize)) {
            std::cerr << "queBytes (" << queBytes << ") × bufNum (" << bufNum << ") × 队列数 (" << QUEUE_NUM
                      << ") = " << ubNeeded << " B 超出 UB 容量 " << ubSize << " B，已跳过" << std::endl;
            // 扫默认列表时超预算属硬件容量所限，不算运行失败；命令行显式指定的组合跑不成才置错误码。
            if (argc == 3) {
                ret = 1;
            }
            continue;
        }
        uint32_t ubFactor = static_cast<uint32_t>(queBytes / sizeof(float));
        int64_t loops = (blockFactor + ubFactor - 1) / ubFactor;
        uint32_t tailCount = static_cast<uint32_t>(blockFactor - (loops - 1) * ubFactor);

        // 每轮重新申请 device 内存并刷入 x，从干净内存起测、不带上一轮的 cache/数据残留。
        uint8_t* x = nullptr;
        CHECK_ACL(aclrtMalloc((void**)&x, DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMemcpy(x, DATA_BYTES, hData.data(), DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));

        bw_read_kernel<<<coreNum, nullptr, stream>>>(
            x, blockFactor, loops, tailCount, ubFactor, static_cast<uint32_t>(bufNum));
        CHECK_ACL(aclrtSynchronizeStream(stream));

        // 纯读、无输出，正确性不在本样例考察范围；带宽由 msprof 采集 Task Duration 计算。
        std::cout << "queBytes=" << queBytes << " bufNum=" << bufNum << " 读取完成（" << DATA_BYTES << " bytes）"
                  << std::endl;

        CHECK_ACL(aclrtFree(x));
    }

    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    return ret;
}
