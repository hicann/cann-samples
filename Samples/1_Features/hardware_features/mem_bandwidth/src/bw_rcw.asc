/*!
 * \file bw_rcw.asc
 * \brief 读写带宽测试（单输入单输出 abs 算子），TPipe + TQue + DoubleBuffer 三段流水。
 *
 * 1 路输入 x、1 路输出 y（float 随机数）。kernel 做 y = |x|：CopyIn(MTE2 搬入 UB) →
 * Compute(Abs) → CopyOut(MTE3 搬出 GM)，buffer 数（2 即 DoubleBuffer，与 tile 成对扫描）让搬运与 vector 计算重叠。
 * 全核参与（数据量被核数整除，各核 blockFactor 与 tiling 一致；核内再切 UB tile + UB 尾块）。
 * UB tile 大小（即 pipe.InitBuffer 分配给每个 buffer 的字节数）与 buffer 数成对扫描：命令行同时给 <queBytes> <bufNum>
 * 时只跑该组合，否则按下标成对扫 DEFAULT_QUE_BYTES_LIST 与 DEFAULT_BUFFER_NUM_LIST。
 * 耗时用 msprof 采集 Task Duration / aiv_mte2_time / aiv_mte3_time，
 * 带宽 =（读 dataBytes + 写 dataBytes）/ 时间。
 *
 * CLI: bw_rcw [queBytes bufNum]（两参数须同时给出，或都不给以扫默认列表）
 */

#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <random>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include "bw_common.h"

// ---------------------------------------------------------------------------
// Kernel：1 入 1 出，y = |x|（CopyIn → Abs → CopyOut，DoubleBuffer 重叠）
// ---------------------------------------------------------------------------
using namespace AscendC;

class KernelBwRcw {
public:
    __aicore__ inline KernelBwRcw()
    {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, int64_t blockFactor, int64_t loops, uint32_t tailCount,
        uint32_t ubFactor, uint32_t bufNum)
    {
        loops_ = loops;
        tailCount_ = tailCount;
        ubFactor_ = ubFactor;

        int64_t coreOffset = blockFactor * GetBlockIdx();
        xGm_.SetGlobalBuffer((__gm__ float*)x + coreOffset, blockFactor);
        yGm_.SetGlobalBuffer((__gm__ float*)y + coreOffset, blockFactor);

        pipe_.InitBuffer(inQue_, bufNum, ubFactor * sizeof(float));
        pipe_.InitBuffer(outQue_, bufNum, ubFactor * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        int64_t offset = 0;
        for (int64_t i = 0; i < loops_ - 1; ++i) {
            CopyIn(offset, ubFactor_);
            Compute(ubFactor_);
            CopyOut(offset, ubFactor_);
            offset += ubFactor_;
        }
        CopyIn(offset, tailCount_);
        Compute(tailCount_);
        CopyOut(offset, tailCount_);
    }

private:
    __aicore__ inline void CopyIn(int64_t offset, uint32_t count)
    {
        LocalTensor<float> xLocal = inQue_.AllocTensor<float>();
        DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        DataCopyPadExtParams<float> padParams{false, 0, 0, 0};
        DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
        inQue_.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t count)
    {
        LocalTensor<float> xLocal = inQue_.DeQue<float>();
        LocalTensor<float> yLocal = outQue_.AllocTensor<float>();
        Abs(yLocal, xLocal, count);
        outQue_.EnQue(yLocal);
        inQue_.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(int64_t offset, uint32_t count)
    {
        LocalTensor<float> yLocal = outQue_.DeQue<float>();
        DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
        DataCopyPad(yGm_[offset], yLocal, copyParams);
        outQue_.FreeTensor(yLocal);
    }

    TPipe pipe_;
    TQue<TPosition::VECIN, 1> inQue_;
    TQue<TPosition::VECOUT, 1> outQue_;
    GlobalTensor<float> xGm_, yGm_;
    int64_t loops_ = 0;
    uint32_t tailCount_ = 0;
    uint32_t ubFactor_ = 0;
};

__global__ __aicore__ __vector__ void bw_rcw_kernel(
    GM_ADDR x, GM_ADDR y, int64_t blockFactor, int64_t loops, uint32_t tailCount, uint32_t ubFactor, uint32_t bufNum)
{
    KernelBwRcw op;
    op.Init(x, y, blockFactor, loops, tailCount, ubFactor, bufNum);
    op.Process();
}

// ---------------------------------------------------------------------------
// Host
// ---------------------------------------------------------------------------
int main(int argc, char** argv)
{
    // queBytes / bufNum 成对：命令行须同时给出 <queBytes> <bufNum> 只跑这一组；不给参数则按下标
    // 扫 DEFAULT_QUE_BYTES_LIST 与 DEFAULT_BUFFER_NUM_LIST。只给一个参数视为用法错误。
    std::vector<int64_t> queBytesList;
    std::vector<int32_t> bufNumList;
    if (argc == 1) {
        int n = sizeof(DEFAULT_QUE_BYTES_LIST) / sizeof(DEFAULT_QUE_BYTES_LIST[0]);
        for (int i = 0; i < n; ++i) {
            queBytesList.push_back(DEFAULT_QUE_BYTES_LIST[i]);
            bufNumList.push_back(DEFAULT_BUFFER_NUM_LIST[i]);
        }
    } else if (argc == 3) {
        queBytesList.push_back(std::atoll(argv[1]));
        bufNumList.push_back(std::atoi(argv[2]));
    } else {
        std::cerr << "用法: " << argv[0] << " [queBytes bufNum]（两参数须同时给出，或都不给以扫默认列表）" << std::endl;
        return 1;
    }

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    int64_t coreNum = static_cast<int64_t>(ascendcPlatform->GetCoreNumAiv());
    uint64_t ubSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);

    int64_t elems = DATA_BYTES / static_cast<int64_t>(sizeof(float));

    if (elems % coreNum != 0) {
        std::cerr << "数据量 " << elems << " floats 不能被核数 " << coreNum << " 整除，请调整 DATA_BYTES" << std::endl;
        return 1;
    }
    int64_t blockFactor = elems / coreNum;

    // 生成随机数（含负数，让 abs 有意义；同时避免全零内存被压缩、读出虚高带宽）。
    std::vector<float> hData(elems);
    std::mt19937 gen(12345);
    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
    for (int64_t i = 0; i < elems; ++i) {
        hData[i] = dist(gen);
    }

    std::vector<float> yHost(elems);
    constexpr int64_t DATABLOCK = 32;
    constexpr int64_t QUEUE_NUM = 2; // inQue_ 与 outQue_ 各占一份，UB 占用是单队列样例的两倍
    int ret = 0;

    for (size_t idx = 0; idx < queBytesList.size(); ++idx) {
        int64_t queBytes = queBytesList[idx];
        int32_t bufNum = bufNumList[idx];
        if (queBytes <= 0 || queBytes % DATABLOCK != 0) {
            std::cerr << "queBytes (" << queBytes << ") 必须是 32B 的正整数倍，已跳过" << std::endl;
            ret = 1;
            continue;
        }
        if (bufNum < 1) {
            std::cerr << "bufNum (" << bufNum << ") 必须 ≥ 1，已跳过" << std::endl;
            ret = 1;
            continue;
        }
        // UB 预算：每条队列占 bufNum × queBytes，本样例队列数见 QUEUE_NUM。
        int64_t ubNeeded = queBytes * bufNum * QUEUE_NUM;
        if (ubNeeded > static_cast<int64_t>(ubSize)) {
            std::cerr << "queBytes (" << queBytes << ") × bufNum (" << bufNum << ") × 队列数 (" << QUEUE_NUM
                      << ") = " << ubNeeded << " B 超出 UB 容量 " << ubSize << " B，已跳过" << std::endl;
            // 扫默认列表时超预算属硬件容量所限，不算运行失败；命令行显式指定的组合跑不成才置错误码。
            if (argc == 3) {
                ret = 1;
            }
            continue;
        }
        uint32_t ubFactor = static_cast<uint32_t>(queBytes / sizeof(float));
        int64_t loops = (blockFactor + ubFactor - 1) / ubFactor;
        uint32_t tailCount = static_cast<uint32_t>(blockFactor - (loops - 1) * ubFactor);

        // 每轮重新申请 device 内存并刷入 x，从干净内存起测、不带上一轮的 cache/数据残留；
        // 轮末显式 aclrtFree 释放。
        uint8_t *x = nullptr, *y = nullptr;
        CHECK_ACL(aclrtMalloc((void**)&x, DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMalloc((void**)&y, DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMemcpy(x, DATA_BYTES, hData.data(), DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE));

        bw_rcw_kernel<<<coreNum, nullptr, stream>>>(
            x, y, blockFactor, loops, tailCount, ubFactor, static_cast<uint32_t>(bufNum));
        CHECK_ACL(aclrtSynchronizeStream(stream));

        // 精度校验：拷回 y，与 host 端参考 |x| 逐元素比对（数据量整除核数，全部元素都被处理）。
        CHECK_ACL(aclrtMemcpy(yHost.data(), DATA_BYTES, y, DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));
        int64_t errCount = 0;
        float maxErr = 0.0f;
        for (int64_t i = 0; i < elems; ++i) {
            float ref = std::fabs(hData[i]);
            float diff = std::fabs(yHost[i] - ref);
            if (diff > maxErr) {
                maxErr = diff;
            }
            if (diff > 1e-6f) {
                ++errCount;
            }
        }
        double passRate = 100.0 * (elems - errCount) / elems;
        std::cout << "queBytes=" << queBytes << " bufNum=" << bufNum << " 精度通过率=" << passRate
                  << "% maxErr=" << maxErr << std::endl;
        if (errCount != 0) {
            ret = 1;
        }

        CHECK_ACL(aclrtFree(x));
        CHECK_ACL(aclrtFree(y));
    }

    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(0));
    CHECK_ACL(aclFinalize());
    return ret;
}
