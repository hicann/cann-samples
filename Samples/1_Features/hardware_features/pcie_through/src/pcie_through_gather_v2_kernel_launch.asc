/*!
 * \file pcie_through_gather_v2_kernel_launch.asc
 * \brief 通过 <<<>>> kernel 直调方式调用 GatherV2 算子，并支持 PCIe through 特性
 *
 * PCIe through 特性允许 Device 直接访问 Host 内存，避免显式 H2D/D2H 拷贝。
 * 本样例的完整流程如下：
 *   1. 通过 aclrtMallocHost 在 Host 侧分配内存
 *   2. 通过 aclrtHostRegister(ACL_HOST_REGISTER_MAPPED) 将 Host 内存映射到 Device 地址空间
 *   3. 将映射后的 Device 指针直接传入 kernel 的 __gm__ 参数
 *   4. kernel 内部通过 DataCopyPad（PCIe 安全的 DMA 搬运）从 Host 映射地址读写数据
 *   5. 计算完成后结果直接写入 Host 内存，无需 D2H 拷贝
 *
 * 注意：kernel 直调场景下，kernel 实现需自行确保使用 PCIe 安全的搬运接口（DataCopyPad），
 * 不能使用 atomic 或 SIMT 等不兼容 PCIe 的操作。
 */

#include "acl/acl.h"
#include "acl/acl_rt.h"
#include "kernel_operator.h"
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <string>

using namespace AscendC;

namespace {

constexpr int64_t DIM = 0;
constexpr int64_t M = 4;
constexpr int64_t N = 8;
constexpr int64_t IDX_NUM = 3;

/**
 * Host 内存管理 RAII 封装：自动在析构时 unregister + free
 */
struct HostMemGuard {
    void *ptr = nullptr;           // Host 侧内存地址
    bool registered = false;       // 是否已通过 aclrtHostRegister 注册映射
    void *devPtr = nullptr;        // 映射后的 Device 侧地址
    size_t bytes = 0;
};

/**
 * 判断当前环境是否为 PCIe through 场景
 * 需满足两个条件：
 *   1. 环境变量 OP_PCIE_THROUGH_ACCESS_HOST_MEM_CHECK_ENABLE=1
 *   2. Host-Device 连接类型为 PCIe（ACL_HOST_DEVICE_CONNECT_TYPE_PCIE）
 *   3. Host地址到Device地址是否映射成功
 */
bool IsPcieThrough(uint32_t deviceId, void *deviceAddr)
{
    bool isPcieThrough = false;
    const char *pcieThroughEnv = std::getenv("OP_PCIE_THROUGH_ACCESS_HOST_MEM_CHECK_ENABLE");
    int64_t pcieThroughValue =
        (pcieThroughEnv != nullptr && std::string(pcieThroughEnv) == "1") ? 1 : 0;
    if (!pcieThroughValue) {
        return false;
    }

    int64_t hdConnectType = -1;
    aclError ret = aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_HD_CONNECT_TYPE, &hdConnectType);
    if (ret != ACL_SUCCESS) {
        std::fprintf(stderr, "aclrtGetDeviceInfo failed, ret=%d\n", ret);
        return false;
    }

    if (hdConnectType == ACL_HOST_DEVICE_CONNECT_TYPE_PCIE) {
        isPcieThrough = deviceAddr != nullptr;
    }

    return isPcieThrough;
}

void PrintResult(const float *hostPtr, int64_t count)
{
    std::printf("GatherV2 result (kernel launch, PCIe through):\n");
    for (int64_t i = 0; i < count; ++i) {
        std::printf("  out[%lld] = %.1f\n", static_cast<long long>(i), hostPtr[i]);
    }
}

bool CheckResult(const float *out, const float *x, const int64_t *index, int64_t idxNum, int64_t n)
{
    for (int64_t i = 0; i < idxNum; ++i) {
        for (int64_t j = 0; j < n; ++j) {
            float expected = x[index[i] * n + j];
            if (out[i * n + j] != expected) {
                std::fprintf(stderr, "Mismatch at out[%lld][%lld]: got %.1f, expected %.1f\n",
                             static_cast<long long>(i), static_cast<long long>(j),
                             out[i * n + j], expected);
                return false;
            }
        }
    }
    return true;
}

/**
 * GatherV2 kernel 实现
 * 语义：y[i][j] = x[indices[i]][j]，按行整体搬运
 * PCIe through 安全性：仅使用 DataCopyPad（连续地址 DMA 搬运）+ Duplicate（Vector 填充），
 * 不使用 atomic、SIMT 等不兼容 PCIe 的操作
 */
template <typename DATA_TYPE, typename INDICES_TYPE>
__global__ __aicore__ __vector__ void gather_v2_kernel(__gm__ DATA_TYPE *x, __gm__ INDICES_TYPE *indices,
                                                        __gm__ DATA_TYPE *y, int64_t gatherDimSize,
                                                        int64_t indicesDimSize, int64_t innerDimSize)
{
    constexpr int64_t BUFFER_NUM = 2;
    int64_t blockIdx = GetBlockIdx();
    int64_t blockDim = GetBlockNum();

    // 多核按行分配，每个核处理若干完整的行
    int64_t rowPerCore = (indicesDimSize + blockDim - 1) / blockDim;

    uint32_t rowBytes = static_cast<uint32_t>(innerDimSize * sizeof(DATA_TYPE));

    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> indicesQue;
    TQue<QuePosition::VECIN, BUFFER_NUM> xQue;
    TQue<QuePosition::VECOUT, BUFFER_NUM> yQue;

    // 分配 UB 缓冲区：indices 缓冲（32 字节对齐）+ x 行缓冲 + y 行缓冲
    pipe.InitBuffer(indicesQue, BUFFER_NUM, 32);  // 1 个 index 值，32 字节对齐
    pipe.InitBuffer(xQue, BUFFER_NUM, rowBytes);
    pipe.InitBuffer(yQue, BUFFER_NUM, rowBytes);

    GlobalTensor<INDICES_TYPE> indicesGm;
    GlobalTensor<DATA_TYPE> xGm;
    GlobalTensor<DATA_TYPE> yGm;
    indicesGm.SetGlobalBuffer(indices);
    xGm.SetGlobalBuffer(x);
    yGm.SetGlobalBuffer(y);

    DataCopyExtParams rowCopyParams{1, rowBytes, 0, 0, 0};
    DataCopyPadExtParams<DATA_TYPE> rowPadParams{false, 0, 0, 0};
    DataCopyExtParams idxCopyParams{1, static_cast<uint32_t>(sizeof(INDICES_TYPE)), 0, 0, 0};
    DataCopyPadExtParams<INDICES_TYPE> idxPadParams{false, 0, 0, 0};

    for (int64_t i = 0; i < rowPerCore; ++i) {
        int64_t gatherI = i * blockDim + blockIdx;
        if (gatherI >= indicesDimSize) {
            break;
        }

        // CopyIn：从 GM（Host 映射地址）搬运 indices[gatherI] 到 UB
        // DataCopyPad 是 PCIe 安全的 DMA 搬运接口
        LocalTensor<INDICES_TYPE> indicesLocal = indicesQue.AllocTensor<INDICES_TYPE>();
        DataCopyPad(indicesLocal, indicesGm[gatherI], idxCopyParams, idxPadParams);
        indicesQue.EnQue(indicesLocal);
        indicesLocal = indicesQue.DeQue<INDICES_TYPE>();
        {
            event_t eventId = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_S));
            SetFlag<HardEvent::MTE2_S>(eventId);
            WaitFlag<HardEvent::MTE2_S>(eventId);
        }

        INDICES_TYPE indicesValue = indicesLocal.GetValue(0);
        indicesQue.FreeTensor(indicesLocal);

        bool indexOutOfBound = indicesValue < 0 || indicesValue >= gatherDimSize;
        int64_t outOffset = gatherI * innerDimSize;

        if (indexOutOfBound) {
            // Write zero row to y[outOffset]
            LocalTensor<DATA_TYPE> yLocal = yQue.AllocTensor<DATA_TYPE>();
            Duplicate(yLocal, static_cast<DATA_TYPE>(0), innerDimSize);
            yQue.EnQue(yLocal);
            yLocal = yQue.DeQue<DATA_TYPE>();
            {
                event_t eventId = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE3));
                SetFlag<HardEvent::V_MTE3>(eventId);
                WaitFlag<HardEvent::V_MTE3>(eventId);
            }
            DataCopyPad(yGm[outOffset], yLocal, rowCopyParams);
            yQue.FreeTensor(yLocal);
        } else {
            int64_t xIndex = static_cast<int64_t>(indicesValue) * innerDimSize;
            // CopyIn：从 GM（Host 映射地址）搬运 x 的一行数据到 UB
            LocalTensor<DATA_TYPE> xLocal = xQue.AllocTensor<DATA_TYPE>();
            DataCopyPad(xLocal, xGm[xIndex], rowCopyParams, rowPadParams);
            xQue.EnQue(xLocal);
            xLocal = xQue.DeQue<DATA_TYPE>();

            // CopyOut：将结果行从 UB 写回 GM（Host 映射地址），结果直接在 Host 内存可见
            LocalTensor<DATA_TYPE> yLocal = yQue.AllocTensor<DATA_TYPE>();
            DataCopy(yLocal, xLocal, innerDimSize);
            yQue.EnQue(yLocal);
            yLocal = yQue.DeQue<DATA_TYPE>();
            {
                event_t eventId = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE3));
                SetFlag<HardEvent::V_MTE3>(eventId);
                WaitFlag<HardEvent::V_MTE3>(eventId);
            }
            DataCopyPad(yGm[outOffset], yLocal, rowCopyParams);
            xQue.FreeTensor(xLocal);
            yQue.FreeTensor(yLocal);
        }
    }
}

void CHECK_ACL(aclError ret)
{
    if (ret != ACL_SUCCESS) {
        std::fprintf(stderr, "ACL error %d at %s:%d\n", static_cast<int>(ret), __FILE__, __LINE__);
        exit(1);
    }
}

int32_t PrepareHostMemory(HostMemGuard &xHost, HostMemGuard &idxHost, HostMemGuard &outHost)
{
    int64_t xTotal = M * N;
    int64_t outTotal = IDX_NUM * N;
    size_t xBytes = static_cast<size_t>(xTotal) * sizeof(float);
    size_t idxBytes = static_cast<size_t>(IDX_NUM) * sizeof(int64_t);
    size_t outBytes = static_cast<size_t>(outTotal) * sizeof(float);

    CHECK_ACL(aclrtMallocHost(&xHost.ptr, xBytes));
    xHost.bytes = xBytes;
    CHECK_ACL(aclrtMallocHost(&idxHost.ptr, idxBytes));
    idxHost.bytes = idxBytes;
    CHECK_ACL(aclrtMallocHost(&outHost.ptr, outBytes));
    outHost.bytes = outBytes;

    std::printf("[MallocHost] xHost=%p idxHost=%p outHost=%p\n", xHost.ptr, idxHost.ptr, outHost.ptr);

    for (int64_t i = 0; i < xTotal; ++i) {
        (static_cast<float *>(xHost.ptr))[i] = static_cast<float>(i);
    }
    int64_t idxData[IDX_NUM] = {3, 0, 2};
    std::copy_n(idxData, IDX_NUM, static_cast<int64_t *>(idxHost.ptr));
    std::fill_n(static_cast<float *>(outHost.ptr), outTotal, 0.0f);
    return 0;
}

int32_t RegisterHostMemory(HostMemGuard &xHost, HostMemGuard &idxHost, HostMemGuard &outHost)
{
    CHECK_ACL(aclrtHostRegister(xHost.ptr, xHost.bytes, ACL_HOST_REGISTER_MAPPED, &xHost.devPtr));
    xHost.registered = true;
    CHECK_ACL(aclrtHostRegister(idxHost.ptr, idxHost.bytes, ACL_HOST_REGISTER_MAPPED, &idxHost.devPtr));
    idxHost.registered = true;
    CHECK_ACL(aclrtHostRegister(outHost.ptr, outHost.bytes, ACL_HOST_REGISTER_MAPPED, &outHost.devPtr));
    outHost.registered = true;

    std::printf("[HostRegister] xDev=%p idxDev=%p outDev=%p\n", xHost.devPtr, idxHost.devPtr, outHost.devPtr);
    return 0;
}

int32_t ExecuteKernel(HostMemGuard &xHost, HostMemGuard &idxHost, HostMemGuard &outHost,
                      aclrtStream stream)
{
    std::printf("[PCIeThrough] Detected PCIe through scenario, operator will use SIMD tiling path\n");
    int64_t gatherDimSize = M;
    int64_t indicesDimSize = IDX_NUM;
    int64_t innerDimSize = N;
    int64_t outTotal = IDX_NUM * N;

    uint64_t maxCoreNum = 4;
    uint64_t numBlock = std::min(static_cast<uint64_t>(outTotal), maxCoreNum);

    // 将 Host 映射后的 Device 地址直接传入 kernel 的 __gm__ 参数
    // kernel 内部通过 DataCopyPad 访问这些地址，实际通过 PCIe 读写 Host 内存
    float *xGm = (float *)(xHost.devPtr);
    int64_t *idxGm = (int64_t *)(idxHost.devPtr);
    float *outGm = (float *)(outHost.devPtr);
    gather_v2_kernel<float, int64_t><<<numBlock, nullptr, stream>>>(
        xGm, idxGm, outGm, gatherDimSize, indicesDimSize, innerDimSize);

    CHECK_ACL(aclrtSynchronizeStream(stream));
    std::printf("[Execute] GatherV2 kernel completed\n");
    return 0;
}

int32_t VerifyAndPrint(HostMemGuard &xHost, HostMemGuard &idxHost, HostMemGuard &outHost)
{
    int64_t outTotal = IDX_NUM * N;

    PrintResult(static_cast<float *>(outHost.ptr), outTotal);

    bool ok = CheckResult(static_cast<float *>(outHost.ptr), static_cast<float *>(xHost.ptr),
                          static_cast<int64_t *>(idxHost.ptr), IDX_NUM, N);
    if (ok) {
        std::printf("[Verify] PASSED: output matches expected values\n");
    } else {
        std::fprintf(stderr, "[Verify] FAILED: output does not match\n");
    }
    return ok ? 0 : 1;
}

} // namespace

int32_t main()
{
    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = 0;
    CHECK_ACL(aclrtSetDevice(deviceId));
    std::printf("[Init] ACL initialized, device=%d\n", deviceId);

    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    HostMemGuard xHost;
    HostMemGuard idxHost;
    HostMemGuard outHost;

    // ==================== 第一步：在 Host 侧分配内存并设置输入值 ====================
    if (PrepareHostMemory(xHost, idxHost, outHost) != 0) {
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return 1;
    }

    // ==================== 第二步：将 Host 内存映射到 Device 地址空间 ====================
    if (RegisterHostMemory(xHost, idxHost, outHost) != 0) {
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return 1;
    }

    // ==================== 第三步：检测是否 PCIe through 场景 ====================
    if (!IsPcieThrough(static_cast<uint32_t>(deviceId), xHost.devPtr)) {
        std::printf("[PCIeThrough] Non-PCIe scenario\n");
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return 0;
    }

    std::printf("[PCIeThrough] Detected PCIe through scenario, operator will use SIMD tiling path\n");

    // ==================== 第四步：通过 <<<>>> 直调 kernel ====================
    int32_t ret = ExecuteKernel(xHost, idxHost, outHost, stream);

    // ==================== 第五步：结果打印和验证 ====================
    if (ret == 0) {
        ret = VerifyAndPrint(xHost, idxHost, outHost);
    }

    aclrtDestroyStream(stream);
    if (outHost.registered) { aclrtHostUnregister(outHost.ptr); }
    if (idxHost.registered) { aclrtHostUnregister(idxHost.ptr); }
    if (xHost.registered) { aclrtHostUnregister(xHost.ptr); }
    if (outHost.ptr != nullptr) { aclrtFreeHost(outHost.ptr); }
    if (idxHost.ptr != nullptr) { aclrtFreeHost(idxHost.ptr); }
    if (xHost.ptr != nullptr) { aclrtFreeHost(xHost.ptr); }
    aclrtResetDevice(deviceId);
    aclFinalize();

    return ret;
}
