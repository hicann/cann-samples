/*!
 * \file 0_separate.asc
 * \brief Case 0: Cube MatMul and Vector ReLU launched separately (no CV fusion).
 */

#include "kernel_common.h"
#include "host_runner.h"

__global__ __mix__(1, 2) void matmul_only(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    AscendC::InitSocState();
    uint32_t logicCoreId = GetLogicCoreId();

    CubePipe pipe;
    pipe.Init(a, b, c);
    AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, 0,
        static_cast<uint32_t>(MATMUL_RELU_BASE_M) * MATMUL_RELU_BASE_N);

    // Separate MatMul: AIC-only tile loop (no per-tile CrossCore). Matches “CV 分离” baseline.
    if ASCEND_IS_AIC {
        if (logicCoreId < MATMUL_RELU_NUM_BLOCKS) {
            pipe.InitAicSyncFlags();
            for (uint32_t blockId = logicCoreId; blockId < MATMUL_RELU_MN_BLOCKS;
                blockId += MATMUL_RELU_NUM_BLOCKS) {
                uint32_t mIterIdx = 0;
                uint32_t nIterIdx = 0;
                DecodeMnBlock(blockId, mIterIdx, nIterIdx);
                // n-outer / m-inner for B locality (same as gelu / Case1/2).
                for (uint32_t nBlockIdx = 0; nBlockIdx < MATMUL_RELU_N_TILES_PER_CORE; nBlockIdx++) {
                    for (uint32_t mBlockIdx = 0; mBlockIdx < MATMUL_RELU_M_TILES_PER_CORE; mBlockIdx++) {
                        uint32_t mTileIdx = GlobalMTileIdx(mIterIdx, mBlockIdx);
                        uint32_t nTileIdx = GlobalNTileIdx(nIterIdx, nBlockIdx);
                        pipe.RunMatmul(cLocal, mTileIdx, nTileIdx);
                        pipe.FixpipeToGm(cLocal, mTileIdx, nTileIdx);
                    }
                }
            }
            pipe.WaitAicSyncFlags();
        }
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __mix__(1, 2) void relu_only(__gm__ uint8_t* cInOut)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIV {
        constexpr uint32_t halfM = MATMUL_RELU_BASE_M / 2;
        constexpr uint32_t halfMN = halfM * MATMUL_RELU_BASE_N;

        uint32_t logicCoreId = AscendC::GetBlockIdx() / 2;
        if (logicCoreId < MATMUL_RELU_NUM_BLOCKS) {
            AscendC::GlobalTensor<float> cGM;
            cGM.SetGlobalBuffer((__gm__ float*)cInOut);
            AscendC::LocalTensor<float> xUB(AscendC::TPosition::VECCALC, 0, halfMN);
            AscendC::LocalTensor<float> yUB(AscendC::TPosition::VECCALC, halfMN * sizeof(float), halfMN);
            uint32_t localSubIdx = AscendC::GetSubBlockIdx() % 2;
            uint8_t ubMutex = AscendC::AllocMutexID();

            for (uint32_t blockId = logicCoreId; blockId < MATMUL_RELU_MN_BLOCKS;
                blockId += MATMUL_RELU_NUM_BLOCKS) {
                uint32_t mIterIdx = 0;
                uint32_t nIterIdx = 0;
                DecodeMnBlock(blockId, mIterIdx, nIterIdx);
                for (uint32_t mBlockIdx = 0; mBlockIdx < MATMUL_RELU_M_TILES_PER_CORE; mBlockIdx++) {
                    for (uint32_t nBlockIdx = 0; nBlockIdx < MATMUL_RELU_N_TILES_PER_CORE; nBlockIdx++) {
                        uint32_t mTileIdx = GlobalMTileIdx(mIterIdx, mBlockIdx);
                        uint32_t nTileIdx = GlobalNTileIdx(nIterIdx, nBlockIdx);
                        uint32_t gmOffset = mTileIdx * MATMUL_RELU_BASE_M * MATMUL_RELU_N +
                            nTileIdx * MATMUL_RELU_BASE_N + localSubIdx * halfM * MATMUL_RELU_N;

                        AscendC::DataCopyExtParams copyInParams;
                        copyInParams.blockCount = halfM;
                        copyInParams.blockLen = MATMUL_RELU_BASE_N * sizeof(float);
                        copyInParams.srcStride = (MATMUL_RELU_N - MATMUL_RELU_BASE_N) * sizeof(float);
                        copyInParams.dstStride = 0;
                        AscendC::DataCopyPadExtParams<float> padParams = {false, 0, 0, 0};
                        AscendC::Mutex::Lock<PIPE_MTE2>(ubMutex);
                        AscendC::DataCopyPad<float>(xUB, cGM[gmOffset], copyInParams, padParams);
                        AscendC::Mutex::Unlock<PIPE_MTE2>(ubMutex);

                        AscendC::Mutex::Lock<PIPE_V>(ubMutex);
                        AscendC::Relu(yUB, xUB, halfMN);
                        AscendC::Mutex::Unlock<PIPE_V>(ubMutex);

                        AscendC::DataCopyParams copyOutParams;
                        copyOutParams.blockCount = halfM;
                        copyOutParams.blockLen = MATMUL_RELU_BASE_N * sizeof(float);
                        copyOutParams.srcStride = 0;
                        copyOutParams.dstStride = (MATMUL_RELU_N - MATMUL_RELU_BASE_N) * sizeof(float);
                        AscendC::Mutex::Lock<PIPE_MTE3>(ubMutex);
                        AscendC::DataCopyPad<float>(cGM[gmOffset], yUB, copyOutParams);
                        AscendC::Mutex::Unlock<PIPE_MTE3>(ubMutex);
                    }
                }
            }
            AscendC::ReleaseMutexID(ubMutex);
        }
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    HostBuffers buf;
    if (!InitHostAndLoadInputs(buf)) {
        return 1;
    }
    if (!PrepareFreshOutput(buf)) {
        (void)FinalizeRuntime(buf);
        return 1;
    }

    constexpr uint32_t numBlocks = MATMUL_RELU_NUM_BLOCKS;
    if (!CheckAcl(aclrtMemset(buf.cDevice, buf.cFileSize, 0, buf.cFileSize), "aclrtMemset(C)")) {
        (void)FinalizeRuntime(buf);
        return 1;
    }

    matmul_only<<<numBlocks, 0, buf.stream>>>(buf.aDevice, buf.bDevice, buf.cDevice);
    if (!SyncStream(buf, "aclrtSynchronizeStream(matmul_only)")) {
        (void)FinalizeRuntime(buf);
        return 1;
    }

    relu_only<<<numBlocks, 0, buf.stream>>>(buf.cDevice);
    if (!SyncStream(buf, "aclrtSynchronizeStream(relu_only)")) {
        (void)FinalizeRuntime(buf);
        return 1;
    }

    if (!DumpOutputAndFinalize(buf)) {
        return 1;
    }
    printf("Case0 separate MatMul+ReLU completed. shape=%ux%ux%u base=%ux%ux%u singleCore=%ux%ux%u numBlocks=%u\n",
        MATMUL_RELU_M, MATMUL_RELU_K, MATMUL_RELU_N,
        MATMUL_RELU_BASE_M, MATMUL_RELU_BASE_N, MATMUL_RELU_BASE_K,
        MATMUL_RELU_SINGLE_CORE_M, MATMUL_RELU_SINGLE_CORE_N, MATMUL_RELU_SINGLE_CORE_K,
        MATMUL_RELU_NUM_BLOCKS);
    return 0;
}
