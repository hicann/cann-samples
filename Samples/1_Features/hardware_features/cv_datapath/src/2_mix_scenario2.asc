/*!
 * \file 2_mix_scenario2.asc
 * \brief Case 2: Mix kernel + Scenario2 (L0C -> UB -> ReLU -> GM), Ascend 950 Fixpipe.
 */

#include "kernel_common.h"
#include "host_runner.h"

class KernelMatmulReluScenario2 {
public:
    __aicore__ inline KernelMatmulReluScenario2() {}

    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
    {
        pipe.Init(a, b, c);
        xUB = AscendC::LocalTensor<float>(AscendC::TPosition::VECCALC, 0, halfMN);
        yUB = AscendC::LocalTensor<float>(AscendC::TPosition::VECCALC, halfMN * sizeof(float), halfMN);
    }

    __aicore__ inline void Process()
    {
        uint32_t logicCoreId = GetLogicCoreId();
        AscendC::LocalTensor<float> cLocal(AscendC::TPosition::CO1, 0,
            static_cast<uint32_t>(MATMUL_RELU_BASE_M) * MATMUL_RELU_BASE_N);

        if (logicCoreId >= MATMUL_RELU_NUM_BLOCKS) {
            if ASCEND_IS_AIC {
                AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(AIC_SYNC_AIV_FLAG);
            }
            if ASCEND_IS_AIV {
                AscendC::CrossCoreWaitFlag(AIC_SYNC_AIV_FLAG);
            }
            return;
        }

        if ASCEND_IS_AIC {
            pipe.InitAicSyncFlags();
        }
        if ASCEND_IS_AIV {
            yUbMutex = AscendC::AllocMutexID();
        }

        for (uint32_t blockId = logicCoreId; blockId < MATMUL_RELU_MN_BLOCKS;
            blockId += MATMUL_RELU_NUM_BLOCKS) {
            uint32_t mIterIdx = 0;
            uint32_t nIterIdx = 0;
            DecodeMnBlock(blockId, mIterIdx, nIterIdx);
            for (uint32_t nBlockIdx = 0; nBlockIdx < MATMUL_RELU_N_TILES_PER_CORE; nBlockIdx++) {
                for (uint32_t mBlockIdx = 0; mBlockIdx < MATMUL_RELU_M_TILES_PER_CORE; mBlockIdx++) {
                    uint32_t mTileIdx = GlobalMTileIdx(mIterIdx, mBlockIdx);
                    uint32_t nTileIdx = GlobalNTileIdx(nIterIdx, nBlockIdx);
                    if ASCEND_IS_AIC {
                        pipe.RunMatmul(cLocal, mTileIdx, nTileIdx);
                        pipe.FixpipeToUbDualM(xUB, cLocal);
                        AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(AIC_SYNC_AIV_FLAG);
                    }
                    if ASCEND_IS_AIV {
                        ReluFromUb(mTileIdx, nTileIdx);
                    }
                }
            }
        }

        if ASCEND_IS_AIC {
            pipe.WaitAicSyncFlags();
        }
        if ASCEND_IS_AIV {
            AscendC::ReleaseMutexID(yUbMutex);
        }
    }

private:
    __aicore__ inline void ReluFromUb(uint32_t mTileIdx, uint32_t nTileIdx)
    {
        AscendC::CrossCoreWaitFlag(AIC_SYNC_AIV_FLAG);

        AscendC::Mutex::Lock<PIPE_V>(yUbMutex);
        AscendC::Relu(yUB, xUB, halfMN);
        AscendC::Mutex::Unlock<PIPE_V>(yUbMutex);

        uint32_t localSubIdx = AscendC::GetSubBlockIdx() % 2;
        uint32_t gmOffset = mTileIdx * MATMUL_RELU_BASE_M * MATMUL_RELU_N +
            nTileIdx * MATMUL_RELU_BASE_N + localSubIdx * halfM * MATMUL_RELU_N;

        AscendC::DataCopyParams copyOutParams;
        copyOutParams.blockCount = halfM;
        copyOutParams.blockLen = MATMUL_RELU_BASE_N * sizeof(float);
        copyOutParams.srcStride = 0;
        copyOutParams.dstStride = (MATMUL_RELU_N - MATMUL_RELU_BASE_N) * sizeof(float);
        AscendC::Mutex::Lock<PIPE_MTE3>(yUbMutex);
        AscendC::DataCopyPad<float>(pipe.cGM[gmOffset], yUB, copyOutParams);
        AscendC::Mutex::Unlock<PIPE_MTE3>(yUbMutex);
    }

    static constexpr uint32_t halfM = MATMUL_RELU_BASE_M / 2;
    static constexpr uint32_t halfMN = halfM * MATMUL_RELU_BASE_N;

    CubePipe pipe;
    AscendC::LocalTensor<float> xUB;
    AscendC::LocalTensor<float> yUB;
    uint8_t yUbMutex = 0;
};

__global__ __mix__(1, 2) void matmul_relu_scenario2(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    AscendC::InitSocState();
    KernelMatmulReluScenario2 op;
    op.Init(a, b, c);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    HostBuffers buf;
    if (!InitHostAndLoadInputs(buf)) {
        return 1;
    }
    if (!PrepareFreshOutput(buf)) {
        (void)FinalizeRuntime(buf);
        return 1;
    }

    constexpr uint32_t numBlocks = MATMUL_RELU_NUM_BLOCKS;
    matmul_relu_scenario2<<<numBlocks, 0, buf.stream>>>(buf.aDevice, buf.bDevice, buf.cDevice);
    if (!SyncStream(buf, "aclrtSynchronizeStream(scenario2)")) {
        (void)FinalizeRuntime(buf);
        return 1;
    }

    if (!DumpOutputAndFinalize(buf)) {
        return 1;
    }
    printf("Case2 Mix Scenario2 completed. shape=%ux%ux%u base=%ux%ux%u singleCore=%ux%ux%u numBlocks=%u\n",
        MATMUL_RELU_M, MATMUL_RELU_K, MATMUL_RELU_N,
        MATMUL_RELU_BASE_M, MATMUL_RELU_BASE_N, MATMUL_RELU_BASE_K,
        MATMUL_RELU_SINGLE_CORE_M, MATMUL_RELU_SINGLE_CORE_N, MATMUL_RELU_SINGLE_CORE_K,
        MATMUL_RELU_NUM_BLOCKS);
    return 0;
}
