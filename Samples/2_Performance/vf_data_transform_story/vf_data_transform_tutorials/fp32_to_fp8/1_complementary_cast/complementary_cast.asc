/*!
 * \file complementary_cast.asc
 * \brief Step 1: place ZERO and TWO Cast results in complementary FP8 lanes.
 */

#include "acl/acl.h"
#include "kernel_basic_intf.h"
#include "reg_compute/kernel_reg_compute_intf.h"
#include "include/tensor_api/tensor.h"
#include "platform/platform_ascendc.h"
#include "sample_acl_runtime.h"
#include "sample_data_io.h"

#include <cstdint>
#include <iostream>
#include <limits>
#include <string>
#include <vector>

namespace {

constexpr uint32_t kElementsPerRepeat = AscendC::VECTOR_REG_WIDTH / sizeof(float);
constexpr uint32_t kInputChannelsPerGroup = 2;
constexpr uint32_t kElementsPerGroup = kInputChannelsPerGroup * kElementsPerRepeat;
constexpr uint32_t kElementsPerTile = 20480U;
constexpr uint32_t kInputTileBytes = kElementsPerTile * sizeof(float);
constexpr uint32_t kOutputTileBytes = kElementsPerTile * sizeof(uint8_t);
constexpr uint32_t kBufferSlotBytes = kInputTileBytes + kOutputTileBytes;
constexpr uint32_t kBufferCount = 2U;
constexpr uint32_t kAscend950RuntimeUbBytes = 216U * 1024U;
constexpr uint32_t kUbFootprintBytes = kBufferCount * kBufferSlotBytes;

static_assert(kElementsPerRepeat == 64, "Task 1.2 is defined for the Ascend 950 B32 vector width");
static_assert(kElementsPerTile % kElementsPerGroup == 0, "A full tile must contain whole two-channel groups");
static_assert(kBufferSlotBytes % 64 == 0, "Ping-pong UB slots must preserve 64-byte alignment");
static_assert(kInputTileBytes % 64 == 0, "Input UB offsets must preserve 64-byte alignment");
static_assert(kUbFootprintBytes <= kAscend950RuntimeUbBytes, "Double-buffered tiles exceed available UB");

constexpr AscendC::Reg::CastTrait kFp32ToFp8CastTrait = {
    AscendC::Reg::RegLayout::ZERO,
    AscendC::Reg::SatMode::NO_SAT,
    AscendC::Reg::MaskMergeMode::ZEROING,
    AscendC::RoundMode::CAST_RINT,
};

constexpr AscendC::Reg::CastTrait kFp32ToFp8CastTraitTwo = {
    AscendC::Reg::RegLayout::TWO,
    AscendC::Reg::SatMode::NO_SAT,
    AscendC::Reg::MaskMergeMode::ZEROING,
    AscendC::RoundMode::CAST_RINT,
};

__simd_vf__ inline void Fp32ToFp8TutorialVf(__ubuf__ float* input, __ubuf__ uint8_t* output, uint16_t groupTimes)
{
    AscendC::Reg::RegTensor<float> evenInputReg;
    AscendC::Reg::RegTensor<float> oddInputReg;
    AscendC::Reg::RegTensor<fp8_e4m3fn_t> evenOutputReg;
    AscendC::Reg::RegTensor<fp8_e4m3fn_t> oddOutputReg;
    AscendC::Reg::RegTensor<uint8_t> mergedOutputReg;
    AscendC::Reg::RegTensor<uint8_t> packedOutputReg;
    AscendC::Reg::MaskReg fullB32Mask = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::MaskReg fullB8Mask = AscendC::Reg::CreateMask<uint8_t, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::MaskReg halfB8Mask = AscendC::Reg::CreateMask<uint8_t, AscendC::Reg::MaskPattern::VL128>();

    for (uint16_t group = 0; group < groupTimes; ++group) {
        const uint32_t groupOffset = static_cast<uint32_t>(group) * kElementsPerGroup;
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_DINTLV_B32>(
            evenInputReg, oddInputReg, input + groupOffset);

        AscendC::Reg::Cast<fp8_e4m3fn_t, float, kFp32ToFp8CastTrait>(evenOutputReg, evenInputReg, fullB32Mask);
        AscendC::Reg::Cast<fp8_e4m3fn_t, float, kFp32ToFp8CastTraitTwo>(oddOutputReg, oddInputReg, fullB32Mask);
        AscendC::Reg::Or(
            mergedOutputReg, reinterpret_cast<AscendC::Reg::RegTensor<uint8_t>&>(evenOutputReg),
            reinterpret_cast<AscendC::Reg::RegTensor<uint8_t>&>(oddOutputReg), fullB8Mask);
        auto& mergedOutputB16 = reinterpret_cast<AscendC::Reg::RegTensor<uint16_t>&>(mergedOutputReg);
        AscendC::Reg::Pack<uint8_t, uint16_t, AscendC::Reg::HighLowPart::LOWEST>(packedOutputReg, mergedOutputB16);
        AscendC::Reg::StoreAlign<uint8_t, AscendC::Reg::StoreDist::DIST_NORM_B8>(
            output + groupOffset, packedOutputReg, halfB8Mask);
    }
}

template <typename InputTensorType, typename OutputTensorType>
__aicore__ inline void Fp32ToFp8Tile(const InputTensorType& inputUb, const OutputTensorType& outputUb)
{
    const uint32_t computeElements = static_cast<uint32_t>(inputUb.Layout().Size());
    const uint16_t groupTimes = static_cast<uint16_t>(computeElements / kElementsPerGroup);
    auto* inputAddr = reinterpret_cast<__ubuf__ float*>(inputUb.Data().Get());
    auto* outputAddr = reinterpret_cast<__ubuf__ uint8_t*>(outputUb.Data().Get());
    asc_vf_call<Fp32ToFp8TutorialVf>(inputAddr, outputAddr, groupTimes);
}

__global__ __aicore__ __vector__ void WarmupKernel()
{
    AscendC::Nop<8>();
}

template <typename GmTensorType, typename LayoutType>
__aicore__ inline void CopyInputTile(
    const GmTensorType& inputGm, uint64_t tileOffset, uint32_t bufferId, const LayoutType& tileLayout)
{
    const uint64_t inputUbOffset = static_cast<uint64_t>(bufferId) * kBufferSlotBytes;
    auto inputGmTile =
        inputGm.Slice(AscendC::Te::MakeCoord(0U, tileOffset), AscendC::Te::MakeShape(1U, kElementsPerTile));
    auto inputUb =
        AscendC::Te::MakeTensor(AscendC::Te::MakeMemPtr<AscendC::Te::Location::UB, float>(inputUbOffset), tileLayout);
    auto copyGmToUb = AscendC::Te::MakeCopy(AscendC::Te::CopyGM2UB{});
    AscendC::Te::Copy(copyGmToUb, inputUb, inputGmTile);
}

template <typename GmTensorType, typename OutputTensorType>
__aicore__ inline void CopyOutputTile(
    const GmTensorType& outputGm, uint64_t tileOffset, const OutputTensorType& outputUb)
{
    const uint32_t validElements = static_cast<uint32_t>(outputUb.Layout().Size());
    auto outputGmTile =
        outputGm.Slice(AscendC::Te::MakeCoord(0U, tileOffset), AscendC::Te::MakeShape(1U, validElements));
    auto copyUbToGm = AscendC::Te::MakeCopy(AscendC::Te::CopyUB2GM{});
    AscendC::Te::Copy(copyUbToGm, outputGmTile, outputUb);
}

__global__ __aicore__ __vector__ void Fp32ToFp8Kernel(GM_ADDR input, GM_ADDR output, uint32_t m, uint32_t n)
{
    const uint64_t totalElements = static_cast<uint64_t>(m) * n;
    const uint64_t totalTiles = (totalElements + kElementsPerTile - 1U) / kElementsPerTile;
    const uint32_t coreIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
    const uint32_t coreNum = static_cast<uint32_t>(AscendC::GetBlockNum());
    if (coreIdx >= totalTiles) {
        return;
    }

    const uint64_t coreTileCount = (totalTiles - coreIdx + coreNum - 1U) / coreNum;
    const uint64_t paddedElements = totalTiles * kElementsPerTile;
    auto tileLayout = AscendC::Te::MakeFrameLayout<AscendC::Te::NDExtLayoutPtn>(1U, kElementsPerTile);
    auto inputGmLayout = AscendC::Te::MakeFrameLayout<AscendC::Te::NDExtLayoutPtn>(1U, paddedElements);
    auto outputGmLayout = AscendC::Te::MakeFrameLayout<AscendC::Te::NDExtLayoutPtn>(1U, totalElements);
    auto inputGm = AscendC::Te::MakeTensor(
        AscendC::Te::MakeMemPtr<AscendC::Te::Location::GM>(reinterpret_cast<__gm__ float*>(input)), inputGmLayout);
    auto outputGm = AscendC::Te::MakeTensor(
        AscendC::Te::MakeMemPtr<AscendC::Te::Location::GM>(reinterpret_cast<__gm__ uint8_t*>(output)), outputGmLayout);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(1);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(1);

    for (uint64_t localTile = 0; localTile < coreTileCount; ++localTile) {
        const uint32_t bufferId = static_cast<uint32_t>(localTile & 1U);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(bufferId);
        const uint64_t tileIndex = coreIdx + localTile * coreNum;
        const uint64_t tileOffset = tileIndex * kElementsPerTile;
        CopyInputTile(inputGm, tileOffset, bufferId, tileLayout);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(bufferId);

        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(bufferId);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(bufferId);

        const uint64_t remainingElements = totalElements - tileOffset;
        const uint32_t validElements =
            remainingElements > kElementsPerTile ? kElementsPerTile : static_cast<uint32_t>(remainingElements);
        const uint32_t alignedElements =
            (validElements + kElementsPerGroup - 1U) / kElementsPerGroup * kElementsPerGroup;
        auto alignedTileLayout = decltype(tileLayout){
            AscendC::Te::MakeShape(
                AscendC::Te::MakeShape(AscendC::Te::_1{}, 1U),
                AscendC::Te::MakeShape(AscendC::Te::_1{}, alignedElements)),
            tileLayout.Stride()};
        auto validTileLayout = decltype(tileLayout){
            AscendC::Te::MakeShape(
                AscendC::Te::MakeShape(AscendC::Te::_1{}, 1U),
                AscendC::Te::MakeShape(AscendC::Te::_1{}, validElements)),
            tileLayout.Stride()};
        const uint64_t inputUbOffset = static_cast<uint64_t>(bufferId) * kBufferSlotBytes;
        const uint64_t outputUbOffset = inputUbOffset + kInputTileBytes;
        auto inputUb = AscendC::Te::MakeTensor(
            AscendC::Te::MakeMemPtr<AscendC::Te::Location::UB, float>(inputUbOffset), alignedTileLayout);
        auto outputUb = AscendC::Te::MakeTensor(
            AscendC::Te::MakeMemPtr<AscendC::Te::Location::UB, uint8_t>(outputUbOffset), validTileLayout);
        Fp32ToFp8Tile(inputUb, outputUb);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(bufferId);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(bufferId);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(bufferId);
        CopyOutputTile(outputGm, tileOffset, outputUb);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(bufferId);
    }

    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(1);
}

bool QueryDeviceResources(uint32_t& aivCoreNum)
{
    constexpr int32_t kDeviceId = 0;
    int64_t runtimeAivCoreNum = 0;
    int64_t runtimeUbSize = 0;
    if (!CheckAcl(
            aclrtGetDeviceInfo(kDeviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &runtimeAivCoreNum),
            "aclrtGetDeviceInfo(VECTOR_CORE_NUM)") ||
        !CheckAcl(
            aclrtGetDeviceInfo(kDeviceId, ACL_DEV_ATTR_UBUF_PER_VECTOR_CORE, &runtimeUbSize),
            "aclrtGetDeviceInfo(UBUF_PER_VECTOR_CORE)")) {
        return false;
    }

    auto* ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (ascendcPlatform == nullptr || runtimeAivCoreNum <= 0 ||
        runtimeAivCoreNum > std::numeric_limits<uint32_t>::max() || runtimeUbSize <= 0) {
        return false;
    }

    const uint32_t platformAivCoreNum = ascendcPlatform->GetCoreNumAiv();
    uint64_t platformUbSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, platformUbSize);
    if (static_cast<uint64_t>(runtimeUbSize) < kUbFootprintBytes || platformUbSize < kUbFootprintBytes) {
        std::cerr << "The selected tutorial stage requires " << kUbFootprintBytes << " UB bytes, runtime reports "
                  << runtimeUbSize << " and the platform reports " << platformUbSize << '\n';
        return false;
    }

    aivCoreNum = static_cast<uint32_t>(runtimeAivCoreNum);
    std::cout << "[HOST] runtime_aiv_cores=" << aivCoreNum << " platform_aiv_cores=" << platformAivCoreNum
              << " runtime_ub_bytes=" << runtimeUbSize << " platform_ub_bytes=" << platformUbSize
              << " implementation=" "complementary_cast" << " tile_elements=" << kElementsPerTile
              << " buffer_count=" << kBufferCount << " ub_footprint_bytes=" << kUbFootprintBytes << '\n';
    return true;
}

bool MakeCases(
    uint32_t aivCoreNum, CaseSpec& fullCase, CaseSpec& tailCase, CaseSpec& performanceCase, CaseSpec& traceCase)
{
    constexpr uint32_t kFullRowsPerCore = 20U;
    constexpr uint32_t kPerformanceRowsPerCore = 40U;
    if (aivCoreNum > (std::numeric_limits<uint32_t>::max() - 1U) / kPerformanceRowsPerCore) {
        return false;
    }
    fullCase = {"full", aivCoreNum * kFullRowsPerCore, 4096U};
    tailCase = {"tail", aivCoreNum * kFullRowsPerCore + 1U, 4099U};
    performanceCase = {"perf", aivCoreNum * kPerformanceRowsPerCore, 4096U};
    traceCase = {"trace", aivCoreNum * (kElementsPerTile / 4096U), 4096U};
    return true;
}

bool RunCase(aclrtStream stream, const CaseSpec& spec, uint32_t aivCoreNum)
{
    const uint64_t totalElements = static_cast<uint64_t>(spec.m) * spec.n;
    const uint64_t paddedElements = AlignUp(totalElements, kElementsPerTile);
    const uint64_t totalTiles = paddedElements / kElementsPerTile;
    if (totalElements == 0 || paddedElements > std::numeric_limits<size_t>::max() / sizeof(float)) {
        std::cerr << "[HOST][" << spec.name << "] invalid shape (" << spec.m << ", " << spec.n << ")\n";
        return false;
    }

    if (aivCoreNum == 0 || totalTiles < aivCoreNum) {
        std::cerr << "[HOST][" << spec.name << "] shape has " << totalTiles << " tiles and cannot activate all "
                  << aivCoreNum << " AIV cores\n";
        return false;
    }

    VfDataTransformSample::ArtifactPaths paths;
    if (!VfDataTransformSample::GenerateData(
            "fp32_to_fp8", spec.name, spec.m, spec.n, paddedElements, paddedElements, 0U, totalElements, paths)) {
        return false;
    }

    std::vector<float> input;
    std::vector<uint8_t> output;
    if (!VfDataTransformSample::ReadBinaryExact(paths.input, paddedElements, input) ||
        !VfDataTransformSample::ReadBinaryExact(paths.outputInit, paddedElements, output)) {
        return false;
    }

    DeviceBuffer deviceInput;
    DeviceBuffer deviceOutput;
    if (!deviceInput.Allocate(input.size() * sizeof(input[0])) ||
        !deviceOutput.Allocate(output.size() * sizeof(output[0])) || !deviceInput.CopyFromHost(input.data()) ||
        !deviceOutput.CopyFromHost(output.data())) {
        return false;
    }

    Fp32ToFp8Kernel<<<aivCoreNum, nullptr, stream>>>(deviceInput.Get(), deviceOutput.Get(), spec.m, spec.n);
    if (!CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !deviceOutput.CopyToHost(output.data())) {
        return false;
    }

    const bool binMatch = VfDataTransformSample::VerifyOutput(paths, output, 0U, totalElements);

    const uint64_t maxTilesPerCore = (totalTiles + aivCoreNum - 1U) / aivCoreNum;
    const uint32_t lastTileElements = static_cast<uint32_t>(totalElements - (totalTiles - 1U) * kElementsPerTile);
    const uint32_t lastTileGroups = (lastTileElements + kElementsPerGroup - 1U) / kElementsPerGroup;
    const uint32_t lastGroupElements = lastTileElements - (lastTileGroups - 1U) * kElementsPerGroup;
    const bool passed = binMatch;
    std::cout << "[HOST][" << spec.name << "] status=" << (passed ? "PASS" : "FAIL") << " shape=(" << spec.m << ','
              << spec.n << ") elements=" << totalElements << " tiles=" << totalTiles << " aiv_cores=" << aivCoreNum
              << " max_tiles_per_core=" << maxTilesPerCore << " last_tile_elements=" << lastTileElements
              << " last_tile_groups=" << lastTileGroups << " last_group_elements=" << lastGroupElements
              << " bin_match=" << (binMatch ? "true" : "false") << '\n';
    return passed;
}

} // namespace

int main(int argc, char** argv)
{
    std::string selectedCase = "all";
    if (argc == 3 && std::string(argv[1]) == "--case") {
        selectedCase = argv[2];
    } else if (argc != 1) {
        std::cerr << "Usage: " << argv[0] << " [--case full|tail|perf|trace|all]\n";
        return 2;
    }
    if (selectedCase != "all" && selectedCase != "full" && selectedCase != "tail" && selectedCase != "perf" &&
        selectedCase != "trace") {
        std::cerr << "Unknown case: " << selectedCase << '\n';
        return 2;
    }

    AclRuntime runtime;
    if (!runtime.Init()) {
        return 1;
    }

    uint32_t aivCoreNum = 0;
    if (!QueryDeviceResources(aivCoreNum)) {
        std::cerr << "Failed to query a valid Ascend 950 AIV/UB configuration\n";
        return 1;
    }

    CaseSpec fullCase{};
    CaseSpec tailCase{};
    CaseSpec performanceCase{};
    CaseSpec traceCase{};
    if (!MakeCases(aivCoreNum, fullCase, tailCase, performanceCase, traceCase)) {
        std::cerr << "AIV core count cannot be represented by the sample shapes\n";
        return 1;
    }

    WarmupKernel<<<aivCoreNum, nullptr, runtime.Stream()>>>();
    if (!CheckAcl(aclrtSynchronizeStream(runtime.Stream()), "warmup aclrtSynchronizeStream")) {
        return 1;
    }

    bool passed = true;
    if (IsSelected(selectedCase, "full")) {
        passed = RunCase(runtime.Stream(), fullCase, aivCoreNum) && passed;
    }
    if (IsSelected(selectedCase, "tail")) {
        passed = RunCase(runtime.Stream(), tailCase, aivCoreNum) && passed;
    }
    if (IsSelected(selectedCase, "perf")) {
        passed = RunCase(runtime.Stream(), performanceCase, aivCoreNum) && passed;
    }
    if (selectedCase == "trace") {
        passed = RunCase(runtime.Stream(), traceCase, aivCoreNum) && passed;
    }

    return passed ? 0 : 1;
}
