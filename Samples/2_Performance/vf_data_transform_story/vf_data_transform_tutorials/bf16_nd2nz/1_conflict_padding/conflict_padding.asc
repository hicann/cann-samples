/*!
 * \file conflict_padding.asc
 * \brief Step 1: remove V_STORE bank conflicts with a one-row UB padding.
 */

#include "acl/acl.h"
#include "kernel_basic_intf.h"
#include "reg_compute/kernel_reg_compute_intf.h"
#include "include/tensor_api/tensor.h"
#include "platform/platform_ascendc.h"
#include "sample_acl_runtime.h"
#include "sample_data_io.h"

#include <cstdint>
#include <iostream>
#include <limits>
#include <string>
#include <vector>

namespace {

constexpr uint32_t kN0 = 16;
constexpr uint32_t kPhysicalColumns = 128;
constexpr uint32_t kNBlocks = kPhysicalColumns / kN0;
constexpr uint32_t kRowsPerTile = 192;
constexpr uint32_t kPaddedRowsPerTile = 193U;
constexpr uint32_t kInputTileElements = kRowsPerTile * kPhysicalColumns;
constexpr uint32_t kOutputTileElements = kNBlocks * kPaddedRowsPerTile * kN0;
constexpr uint32_t kInputTileBytes = kInputTileElements * sizeof(bfloat16_t);
constexpr uint32_t kOutputTileBytes = kOutputTileElements * sizeof(bfloat16_t);
constexpr uint32_t kBufferSlotBytes = kInputTileBytes + kOutputTileBytes;
constexpr uint32_t kBufferCount = 2U;
constexpr uint32_t kAscend950RuntimeUbBytes = 216U * 1024U;
constexpr uint32_t kUbFootprintBytes = kBufferCount * kBufferSlotBytes;

static_assert(
    AscendC::VECTOR_REG_WIDTH / sizeof(bfloat16_t) == kPhysicalColumns,
    "One BF16 register must cover one physical ND row");
static_assert(kRowsPerTile % kN0 == 0, "The tile row count must preserve standard NZ M alignment");
static_assert(kPaddedRowsPerTile == kRowsPerTile + 1U, "The optimized layout needs one padding row");
static_assert(kBufferSlotBytes % 64 == 0, "Ping-pong UB slots must preserve 64-byte alignment");
static_assert(kInputTileBytes % 64 == 0, "Input UB offsets must preserve 64-byte alignment");
static_assert(kUbFootprintBytes <= kAscend950RuntimeUbBytes, "Double-buffered tiles exceed available UB");

__simd_vf__ inline void Bf16Nd2NzDataBlockCopyVf(
    __ubuf__ bfloat16_t* input, __ubuf__ bfloat16_t* output, uint16_t rowCount, uint32_t dataBlockStride)
{
    AscendC::Reg::RegTensor<bfloat16_t> rowReg;
    AscendC::Reg::MaskReg fullB16Mask = AscendC::Reg::CreateMask<bfloat16_t, AscendC::Reg::MaskPattern::ALL>();

    for (uint16_t row = 0; row < rowCount; ++row) {
        AscendC::Reg::LoadAlign<bfloat16_t, AscendC::Reg::LoadDist::DIST_NORM>(
            rowReg, input + static_cast<uint32_t>(row) * kPhysicalColumns);
        // One DATA_BLOCK_COPY store uses the padded stride of 193 blocks.
        AscendC::Reg::StoreAlign<bfloat16_t, AscendC::Reg::DataCopyMode::DATA_BLOCK_COPY>(
            output + static_cast<uint32_t>(row) * kN0, rowReg, dataBlockStride, fullB16Mask);
    }
}

template <typename InputTensorType, typename OutputTensorType>
__aicore__ inline void Bf16Nd2NzTile(const InputTensorType& inputUb, const OutputTensorType& outputUb)
{
    const uint16_t rowCount = static_cast<uint16_t>(inputUb.Layout().Size() / kPhysicalColumns);
    const uint32_t dataBlockStride = static_cast<uint32_t>(outputUb.Layout().Size() / (kNBlocks * kN0));
    auto* inputAddr = reinterpret_cast<__ubuf__ bfloat16_t*>(inputUb.Data().Get());
    auto* outputAddr = reinterpret_cast<__ubuf__ bfloat16_t*>(outputUb.Data().Get());
    asc_vf_call<Bf16Nd2NzDataBlockCopyVf>(inputAddr, outputAddr, rowCount, dataBlockStride);
}

__global__ __aicore__ __vector__ void WarmupKernel()
{
    AscendC::Nop<8>();
}

template <typename GmTensorType, typename LayoutType>
__aicore__ inline void CopyInputTile(
    const GmTensorType& inputGm, uint64_t inputTileOffset, uint32_t bufferId, const LayoutType& inputTileLayout)
{
    const uint64_t inputUbOffset = static_cast<uint64_t>(bufferId) * kBufferSlotBytes;
    auto inputGmTile =
        inputGm.Slice(AscendC::Te::MakeCoord(0U, inputTileOffset), AscendC::Te::MakeShape(1U, kInputTileElements));
    auto inputUb = AscendC::Te::MakeTensor(
        AscendC::Te::MakeMemPtr<AscendC::Te::Location::UB, bfloat16_t>(inputUbOffset), inputTileLayout);
    auto copyGmToUb = AscendC::Te::MakeCopy(AscendC::Te::CopyGM2UB{});
    AscendC::Te::Copy(copyGmToUb, inputUb, inputGmTile);
}

template <typename GmTensorType, typename OutputTensorType>
__aicore__ inline void CopyOutputTile(
    const GmTensorType& outputGm, uint64_t rowOffset, uint32_t copyRows, const OutputTensorType& outputUb)
{
    auto copyUbToGm = AscendC::Te::MakeCopy(AscendC::Te::CopyUB2GM{});
    auto outputGmTile =
        outputGm.Slice(AscendC::Te::MakeCoord(0U, rowOffset * kN0), AscendC::Te::MakeShape(kNBlocks, copyRows * kN0));
    auto outputUbTile =
        outputUb.Slice(AscendC::Te::MakeCoord(0U, 0U), AscendC::Te::MakeShape(kNBlocks, copyRows * kN0));
    AscendC::Te::Copy(copyUbToGm, outputGmTile, outputUbTile);
}

__global__ __aicore__ __vector__ void Bf16Nd2NzKernel(GM_ADDR input, GM_ADDR output, uint32_t m, uint32_t n)
{
    if (n != kPhysicalColumns) {
        return;
    }
    const uint64_t totalTiles = (static_cast<uint64_t>(m) + kRowsPerTile - 1U) / kRowsPerTile;
    const uint32_t coreIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
    const uint32_t coreNum = static_cast<uint32_t>(AscendC::GetBlockNum());
    if (coreIdx >= totalTiles) {
        return;
    }

    const uint64_t coreTileCount = (totalTiles - coreIdx + coreNum - 1U) / coreNum;
    const uint64_t paddedInputElements = totalTiles * kInputTileElements;
    const uint32_t globalAlignedRows = (m + kN0 - 1U) / kN0 * kN0;
    auto inputTileLayout = AscendC::Te::MakeFrameLayout<AscendC::Te::NDExtLayoutPtn>(1U, kInputTileElements);
    auto outputTileLayout =
        AscendC::Te::MakeFrameLayout<AscendC::Te::NDExtLayoutPtn>(kNBlocks, kPaddedRowsPerTile * kN0);
    auto inputGmLayout = AscendC::Te::MakeFrameLayout<AscendC::Te::NDExtLayoutPtn>(1U, paddedInputElements);
    auto outputGmLayout = AscendC::Te::MakeFrameLayout<AscendC::Te::NDExtLayoutPtn>(kNBlocks, globalAlignedRows * kN0);
    auto inputGm = AscendC::Te::MakeTensor(
        AscendC::Te::MakeMemPtr<AscendC::Te::Location::GM>(reinterpret_cast<__gm__ bfloat16_t*>(input)), inputGmLayout);
    auto outputGm = AscendC::Te::MakeTensor(
        AscendC::Te::MakeMemPtr<AscendC::Te::Location::GM>(reinterpret_cast<__gm__ bfloat16_t*>(output)),
        outputGmLayout);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(1);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(1);

    for (uint64_t localTile = 0; localTile < coreTileCount; ++localTile) {
        const uint32_t bufferId = static_cast<uint32_t>(localTile & 1U);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(bufferId);
        const uint64_t tileIndex = coreIdx + localTile * coreNum;
        const uint64_t rowOffset = tileIndex * kRowsPerTile;
        const uint64_t inputTileOffset = tileIndex * kInputTileElements;
        CopyInputTile(inputGm, inputTileOffset, bufferId, inputTileLayout);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(bufferId);

        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(bufferId);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(bufferId);

        const uint32_t remainingRows = static_cast<uint32_t>(m - rowOffset);
        const uint32_t validRows = remainingRows > kRowsPerTile ? kRowsPerTile : remainingRows;
        const uint32_t copyRows = (validRows + kN0 - 1U) / kN0 * kN0;
        const uint64_t inputUbOffset = static_cast<uint64_t>(bufferId) * kBufferSlotBytes;
        const uint64_t outputUbOffset = inputUbOffset + kInputTileBytes;
        auto inputUb = AscendC::Te::MakeTensor(
            AscendC::Te::MakeMemPtr<AscendC::Te::Location::UB, bfloat16_t>(inputUbOffset), inputTileLayout);
        auto outputUb = AscendC::Te::MakeTensor(
            AscendC::Te::MakeMemPtr<AscendC::Te::Location::UB, bfloat16_t>(outputUbOffset), outputTileLayout);
        Bf16Nd2NzTile(inputUb, outputUb);

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(bufferId);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(bufferId);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(bufferId);
        CopyOutputTile(outputGm, rowOffset, copyRows, outputUb);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(bufferId);
    }

    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(1);
}

bool QueryDeviceResources(uint32_t& aivCoreNum)
{
    constexpr int32_t kDeviceId = 0;
    int64_t runtimeAivCoreNum = 0;
    int64_t runtimeUbSize = 0;
    if (!CheckAcl(
            aclrtGetDeviceInfo(kDeviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &runtimeAivCoreNum),
            "aclrtGetDeviceInfo(VECTOR_CORE_NUM)") ||
        !CheckAcl(
            aclrtGetDeviceInfo(kDeviceId, ACL_DEV_ATTR_UBUF_PER_VECTOR_CORE, &runtimeUbSize),
            "aclrtGetDeviceInfo(UBUF_PER_VECTOR_CORE)")) {
        return false;
    }

    auto* ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (ascendcPlatform == nullptr || runtimeAivCoreNum <= 0 ||
        runtimeAivCoreNum > std::numeric_limits<uint32_t>::max() || runtimeUbSize <= 0) {
        return false;
    }

    const uint32_t platformAivCoreNum = ascendcPlatform->GetCoreNumAiv();
    uint64_t platformUbSize = 0;
    ascendcPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, platformUbSize);
    if (static_cast<uint64_t>(runtimeUbSize) < kUbFootprintBytes || platformUbSize < kUbFootprintBytes) {
        std::cerr << "The selected ND2NZ stage requires " << kUbFootprintBytes << " UB bytes, runtime reports "
                  << runtimeUbSize << " and the platform reports " << platformUbSize << '\n';
        return false;
    }

    aivCoreNum = static_cast<uint32_t>(runtimeAivCoreNum);
    std::cout << "[HOST] runtime_aiv_cores=" << aivCoreNum << " platform_aiv_cores=" << platformAivCoreNum
              << " runtime_ub_bytes=" << runtimeUbSize << " platform_ub_bytes=" << platformUbSize
              << " implementation=conflict_padding"
              << " data_block_stride=" << kPaddedRowsPerTile << " buffer_count=" << kBufferCount
              << " ub_footprint_bytes=" << kUbFootprintBytes << '\n';
    return true;
}

bool MakeCases(
    uint32_t aivCoreNum, CaseSpec& fullCase, CaseSpec& tailCase, CaseSpec& performanceCase, CaseSpec& traceCase)
{
    constexpr uint32_t kFullRowsPerCore = 4U * kRowsPerTile;
    constexpr uint32_t kPerformanceRowsPerCore = 8U * kRowsPerTile;
    constexpr uint32_t kTraceRowsPerCore = kRowsPerTile;
    if (aivCoreNum > (std::numeric_limits<uint32_t>::max() - 1U) / kPerformanceRowsPerCore) {
        return false;
    }
    fullCase = {"full", aivCoreNum * kFullRowsPerCore, kPhysicalColumns};
    tailCase = {"tail", aivCoreNum * kFullRowsPerCore + 17U, kPhysicalColumns};
    performanceCase = {"perf", aivCoreNum * kPerformanceRowsPerCore, kPhysicalColumns};
    traceCase = {"trace", aivCoreNum * kTraceRowsPerCore, kPhysicalColumns};
    return true;
}

bool RunCase(aclrtStream stream, const CaseSpec& spec, uint32_t aivCoreNum)
{
    constexpr size_t kGuardElements = 256U;
    const uint64_t totalTiles = (static_cast<uint64_t>(spec.m) + kRowsPerTile - 1U) / kRowsPerTile;
    const uint64_t paddedInputRows = totalTiles * kRowsPerTile;
    const uint64_t paddedInputElements = paddedInputRows * kPhysicalColumns;
    const uint32_t alignedRows = (spec.m + kN0 - 1U) / kN0 * kN0;
    const uint64_t outputElements = static_cast<uint64_t>(kNBlocks) * alignedRows * kN0;
    if (spec.m == 0 || spec.n != kPhysicalColumns || paddedInputElements > std::numeric_limits<size_t>::max() ||
        outputElements > std::numeric_limits<size_t>::max() - 2U * kGuardElements) {
        std::cerr << "[HOST][" << spec.name << "] invalid shape (" << spec.m << ", " << spec.n << ")\n";
        return false;
    }

    if (aivCoreNum == 0 || totalTiles < aivCoreNum) {
        std::cerr << "[HOST][" << spec.name << "] shape has " << totalTiles << " tiles and cannot activate all "
                  << aivCoreNum << " AIV cores\n";
        return false;
    }

    const uint64_t outputStorageElements = outputElements + 2U * kGuardElements;
    VfDataTransformSample::ArtifactPaths artifacts;
    std::vector<uint16_t> input;
    std::vector<uint16_t> outputStorage;
    if (!VfDataTransformSample::GenerateData(
            "bf16_nd2nz", spec.name, spec.m, spec.n, paddedInputElements, outputStorageElements, kGuardElements,
            outputElements, artifacts) ||
        !VfDataTransformSample::ReadBinaryExact(artifacts.input, paddedInputElements, input) ||
        !VfDataTransformSample::ReadBinaryExact(artifacts.outputInit, outputStorageElements, outputStorage)) {
        return false;
    }

    DeviceBuffer deviceInput;
    DeviceBuffer deviceOutput;
    if (!deviceInput.Allocate(input.size() * sizeof(input[0])) ||
        !deviceOutput.Allocate(outputStorage.size() * sizeof(outputStorage[0])) ||
        !deviceInput.CopyFromHost(input.data()) || !deviceOutput.CopyFromHost(outputStorage.data())) {
        return false;
    }

    Bf16Nd2NzKernel<<<aivCoreNum, nullptr, stream>>>(
        deviceInput.Get(), deviceOutput.Get() + kGuardElements * sizeof(uint16_t), spec.m, spec.n);
    if (!CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !deviceOutput.CopyToHost(outputStorage.data())) {
        return false;
    }

    const uint64_t maxTilesPerCore = (totalTiles + aivCoreNum - 1U) / aivCoreNum;
    const uint32_t lastTileRows = static_cast<uint32_t>(spec.m - (totalTiles - 1U) * kRowsPerTile);
    const uint32_t lastTileCopyRows = (lastTileRows + kN0 - 1U) / kN0 * kN0;
    const bool binMatch = VfDataTransformSample::VerifyOutput(artifacts, outputStorage, kGuardElements, outputElements);
    const bool passed = binMatch;
    std::cout << "[HOST][" << spec.name << "] status=" << (passed ? "PASS" : "FAIL") << " nd_shape=(" << spec.m << ','
              << spec.n << ")"
              << " nz_shape=(" << kNBlocks << ',' << alignedRows << ',' << kN0 << ')' << " tiles=" << totalTiles
              << " aiv_cores=" << aivCoreNum << " max_tiles_per_core=" << maxTilesPerCore
              << " last_tile_rows=" << lastTileRows << " last_tile_copy_rows=" << lastTileCopyRows
              << " m_padding_rows=" << alignedRows - spec.m << " bin_match=" << (binMatch ? "true" : "false") << '\n';
    return passed;
}

} // namespace

int main(int argc, char** argv)
{
    std::string selectedCase = "all";
    if (argc == 3 && std::string(argv[1]) == "--case") {
        selectedCase = argv[2];
    } else if (argc != 1) {
        std::cerr << "Usage: " << argv[0] << " [--case full|tail|perf|trace|all]\n";
        return 2;
    }
    if (selectedCase != "all" && selectedCase != "full" && selectedCase != "tail" && selectedCase != "perf" &&
        selectedCase != "trace") {
        std::cerr << "Unknown case: " << selectedCase << '\n';
        return 2;
    }

    AclRuntime runtime;
    if (!runtime.Init()) {
        return 1;
    }

    uint32_t aivCoreNum = 0;
    if (!QueryDeviceResources(aivCoreNum)) {
        std::cerr << "Failed to query a valid Ascend 950 AIV/UB configuration\n";
        return 1;
    }

    CaseSpec fullCase{};
    CaseSpec tailCase{};
    CaseSpec performanceCase{};
    CaseSpec traceCase{};
    if (!MakeCases(aivCoreNum, fullCase, tailCase, performanceCase, traceCase)) {
        std::cerr << "AIV core count cannot be represented by the sample shapes\n";
        return 1;
    }

    WarmupKernel<<<aivCoreNum, nullptr, runtime.Stream()>>>();
    if (!CheckAcl(aclrtSynchronizeStream(runtime.Stream()), "warmup aclrtSynchronizeStream")) {
        return 1;
    }

    bool passed = true;
    if (IsSelected(selectedCase, "full")) {
        passed = RunCase(runtime.Stream(), fullCase, aivCoreNum) && passed;
    }
    if (IsSelected(selectedCase, "tail")) {
        passed = RunCase(runtime.Stream(), tailCase, aivCoreNum) && passed;
    }
    if (IsSelected(selectedCase, "perf")) {
        passed = RunCase(runtime.Stream(), performanceCase, aivCoreNum) && passed;
    }
    if (selectedCase == "trace") {
        passed = RunCase(runtime.Stream(), traceCase, aivCoreNum) && passed;
    }

    return passed ? 0 : 1;
}
