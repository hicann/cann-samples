    {"type":"text","id":"summary","x":250,"y":730,"width":1240,"height":38,"text":"逐 token 读写 Dk×Dv 状态  →  C 行下三角求解  →  Cube 大矩阵乘","originalText":"逐 token 读写 Dk×Dv 状态  →  C 行下三角求解  →  Cube 大矩阵乘","fontSize":26,"fontFamily":5,"textAlign":"center","verticalAlign":"top","strokeColor":"#1e40af","roughness":1,"opacity":100,"seed":1802,"version":1,"versionNonce":1902,"isDeleted":false,"lineHeight":1.25}
