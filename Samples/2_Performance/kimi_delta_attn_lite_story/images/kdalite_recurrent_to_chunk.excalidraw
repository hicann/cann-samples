    {"type":"text","id":"title","x":60,"y":35,"width":1100,"height":45,"text":"从 Recurrent KDA 到 Chunk KDA","originalText":"从 Recurrent KDA 到 Chunk KDA","fontSize":34,"fontFamily":5,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","roughness":1,"opacity":100,"seed":1001,"version":1,"versionNonce":1101,"isDeleted":false,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":62,"y":88,"width":1320,"height":30,"text":"把逐 token 状态依赖收进 C×C 下三角系统，再用大矩阵乘计算输出","originalText":"把逐 token 状态依赖收进 C×C 下三角系统，再用大矩阵乘计算输出","fontSize":20,"fontFamily":5,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","roughness":1,"opacity":100,"seed":1002,"version":1,"versionNonce":1102,"isDeleted":false,"lineHeight":1.25},

    {"type":"rectangle","id":"recurrent_box","x":55,"y":165,"width":340,"height":455,"strokeColor":"#1e40af","backgroundColor":"#dbeafe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"seed":1101,"version":1,"versionNonce":1201,"isDeleted":false,"roundness":{"type":3}},
    {"type":"text","id":"recurrent_head","x":88,"y":195,"width":275,"height":34,"text":"1  逐 token 更新","originalText":"1  逐 token 更新","fontSize":26,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","strokeColor":"#1e40af","roughness":1,"opacity":100,"seed":1102,"version":1,"versionNonce":1202,"isDeleted":false,"lineHeight":1.25},
    {"type":"text","id":"recurrent_formula","x":83,"y":265,"width":285,"height":180,"text":"H̄ᵢ = Diag(exp(gᵢ)) Hᵢ₋₁\n\npᵢ = kᵢ H̄ᵢ\nrᵢ = βᵢ(vᵢ − pᵢ)\n\nHᵢ = H̄ᵢ + kᵢᵀrᵢ","originalText":"H̄ᵢ = Diag(exp(gᵢ)) Hᵢ₋₁\n\npᵢ = kᵢ H̄ᵢ\nrᵢ = βᵢ(vᵢ − pᵢ)\n\nHᵢ = H̄ᵢ + kᵢᵀrᵢ","fontSize":20,"fontFamily":5,"textAlign":"center","verticalAlign":"top","strokeColor":"#374151","roughness":1,"opacity":100,"seed":1103,"version":1,"versionNonce":1203,"isDeleted":false,"lineHeight":1.35},
    {"type":"text","id":"recurrent_note","x":82,"y":506,"width":288,"height":78,"text":"H̄ᵢ：衰减后、写入 rᵢ 前\nHᵢ：写入 rᵢ 后的真实状态","originalText":"H̄ᵢ：衰减后、写入 rᵢ 前\nHᵢ：写入 rᵢ 后的真实状态","fontSize":18,"fontFamily":5,"textAlign":"center","verticalAlign":"top","strokeColor":"#64748b","roughness":1,"opacity":100,"seed":1104,"version":1,"versionNonce":1204,"isDeleted":false,"lineHeight":1.35},

    {"type":"arrow","id":"arrow_12","x":405,"y":390,"width":72,"height":0,"strokeColor":"#1e3a5f","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":1,"opacity":100,"seed":1201,"version":1,"versionNonce":1301,"isDeleted":false,"points":[[0,0],[72,0]],"startArrowhead":null,"endArrowhead":"arrow"},

    {"type":"rectangle","id":"coordinate_box","x":485,"y":165,"width":340,"height":455,"strokeColor":"#047857","backgroundColor":"#a7f3d0","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"seed":1301,"version":1,"versionNonce":1401,"isDeleted":false,"roundness":{"type":3}},
    {"type":"text","id":"coordinate_head","x":518,"y":195,"width":275,"height":34,"text":"2  换一个状态坐标","originalText":"2  换一个状态坐标","fontSize":26,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","strokeColor":"#047857","roughness":1,"opacity":100,"seed":1302,"version":1,"versionNonce":1402,"isDeleted":false,"lineHeight":1.25},
    {"type":"text","id":"coordinate_formula","x":515,"y":265,"width":280,"height":180,"text":"Gᵢ = Σₜ₌₀ⁱ gₜ\nEᵢ = Diag(exp(Gᵢ))\n\nH̃ᵢ = Eᵢ⁻¹ Hᵢ\n\nH̄ᵢ = Eᵢ H̃ᵢ₋₁\nHᵢ = Eᵢ H̃ᵢ","originalText":"Gᵢ = Σₜ₌₀ⁱ gₜ\nEᵢ = Diag(exp(Gᵢ))\n\nH̃ᵢ = Eᵢ⁻¹ Hᵢ\n\nH̄ᵢ = Eᵢ H̃ᵢ₋₁\nHᵢ = Eᵢ H̃ᵢ","fontSize":20,"fontFamily":5,"textAlign":"center","verticalAlign":"top","strokeColor":"#374151","roughness":1,"opacity":100,"seed":1303,"version":1,"versionNonce":1403,"isDeleted":false,"lineHeight":1.35},
    {"type":"text","id":"coordinate_note","x":515,"y":505,"width":280,"height":80,"text":"H̃ᵢ：移除累计衰减后的推导量\n不是 Kernel 额外保存的状态","originalText":"H̃ᵢ：移除累计衰减后的推导量\n不是 Kernel 额外保存的状态","fontSize":18,"fontFamily":5,"textAlign":"center","verticalAlign":"top","strokeColor":"#64748b","roughness":1,"opacity":100,"seed":1304,"version":1,"versionNonce":1404,"isDeleted":false,"lineHeight":1.35},

    {"type":"arrow","id":"arrow_23","x":835,"y":390,"width":72,"height":0,"strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":3,"strokeStyle":"solid","roughness":1,"opacity":100,"seed":1401,"version":1,"versionNonce":1501,"isDeleted":false,"points":[[0,0],[72,0]],"startArrowhead":null,"endArrowhead":"arrow"},

    {"type":"rectangle","id":"triangular_box","x":915,"y":165,"width":340,"height":455,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"seed":1501,"version":1,"versionNonce":1601,"isDeleted":false,"roundness":{"type":3}},
    {"type":"text","id":"triangular_head","x":948,"y":195,"width":275,"height":34,"text":"3  收集 Chunk 内依赖","originalText":"3  收集 Chunk 内依赖","fontSize":26,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","strokeColor":"#b45309","roughness":1,"opacity":100,"seed":1502,"version":1,"versionNonce":1602,"isDeleted":false,"lineHeight":1.25},
    {"type":"text","id":"triangular_formula","x":945,"y":270,"width":280,"height":175,"text":"Pair = K⁺(K⁻)ᵀ\n\nT = I + StrictLower(Bβ Pair)\n\nT R = Bβ(V − K⁺Hᵢₙ)\nT M = Bβ","originalText":"Pair = K⁺(K⁻)ᵀ\n\nT = I + StrictLower(Bβ Pair)\n\nT R = Bβ(V − K⁺Hᵢₙ)\nT M = Bβ","fontSize":20,"fontFamily":5,"textAlign":"center","verticalAlign":"top","strokeColor":"#374151","roughness":1,"opacity":100,"seed":1503,"version":1,"versionNonce":1603,"isDeleted":false,"lineHeight":1.4},
    {"type":"text","id":"triangular_note","x":945,"y":505,"width":280,"height":80,"text":"token 因果关系变成\nC×C 单位下三角方程","originalText":"token 因果关系变成\nC×C 单位下三角方程","fontSize":18,"fontFamily":5,"textAlign":"center","verticalAlign":"top","strokeColor":"#64748b","roughness":1,"opacity":100,"seed":1504,"version":1,"versionNonce":1604,"isDeleted":false,"lineHeight":1.35},

