    {"type":"rectangle","id":"output_box","x":1345,"y":165,"width":340,"height":455,"strokeColor":"#6d28d9","backgroundColor":"#ddd6fe","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"seed":1701,"version":1,"versionNonce":1801,"isDeleted":false,"roundness":{"type":3}},
    {"type":"text","id":"output_head","x":1378,"y":195,"width":275,"height":34,"text":"4  批量生成结果","originalText":"4  批量生成结果","fontSize":26,"fontFamily":5,"textAlign":"center","verticalAlign":"middle","strokeColor":"#6d28d9","roughness":1,"opacity":100,"seed":1702,"version":1,"versionNonce":1802,"isDeleted":false,"lineHeight":1.25},
    {"type":"text","id":"output_formula","x":1375,"y":265,"width":280,"height":185,"text":"R = M(V − K⁺Hᵢₙ)\n\nO = Q⁺Hᵢₙ + A R\n\nd = exp(Gₜₐᵢₗ)\nHₒᵤₜ = Diag(d)Hᵢₙ\n          + Kₜₐᵢₗᵀ R","originalText":"R = M(V − K⁺Hᵢₙ)\n\nO = Q⁺Hᵢₙ + A R\n\nd = exp(Gₜₐᵢₗ)\nHₒᵤₜ = Diag(d)Hᵢₙ\n          + Kₜₐᵢₗᵀ R","fontSize":20,"fontFamily":5,"textAlign":"center","verticalAlign":"top","strokeColor":"#374151","roughness":1,"opacity":100,"seed":1703,"version":1,"versionNonce":1803,"isDeleted":false,"lineHeight":1.35},
    {"type":"text","id":"output_note","x":1375,"y":505,"width":280,"height":80,"text":"Chunk 内改成大矩阵乘\nChunk 间仍顺序传递 Hₒᵤₜ","originalText":"Chunk 内改成大矩阵乘\nChunk 间仍顺序传递 Hₒᵤₜ","fontSize":18,"fontFamily":5,"textAlign":"center","verticalAlign":"top","strokeColor":"#64748b","roughness":1,"opacity":100,"seed":1704,"version":1,"versionNonce":1804,"isDeleted":false,"lineHeight":1.35},

