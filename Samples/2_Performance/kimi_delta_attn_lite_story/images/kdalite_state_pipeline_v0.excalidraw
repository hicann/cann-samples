    {"type":"text","id":"drain_title","x":48,"y":820,"width":1450,"height":38,"text":"任务结束：最后一份 BF16 状态副本写回 final_state","originalText":"任务结束：最后一份 BF16 状态副本写回 final_state","fontSize":26,"fontFamily":5,"textAlign":"left","verticalAlign":"middle","strokeColor":"#1e40af","roughness":1,"opacity":100,"seed":9092,"version":1,"versionNonce":9192,"isDeleted":false,"lineHeight":1.2},
    {"type":"text","id":"drain_subtitle","x":52,"y":865,"width":1630,"height":28,"text":"仅在全部 Chunk 完成后执行；不属于上方稳态时间轴，AIC 不参与","originalText":"仅在全部 Chunk 完成后执行；不属于上方稳态时间轴，AIC 不参与","fontSize":18,"fontFamily":5,"textAlign":"left","verticalAlign":"middle","strokeColor":"#64748b","roughness":1,"opacity":100,"seed":9093,"version":1,"versionNonce":9193,"isDeleted":false,"lineHeight":1.2},
