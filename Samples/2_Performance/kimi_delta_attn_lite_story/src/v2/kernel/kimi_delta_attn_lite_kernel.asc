#include "kdalite_prepare_aic.h"
#include "kdalite_prepare_aiv.h"
#include "kdalite_state_update_aic.h"
#include "kdalite_state_update_aiv.h"
#include "kdalite_state_update_single_lane_aic.h"
#include "kdalite_state_update_single_lane_aiv.h"

__global__ __mix__(1, 2) void kimi_delta_attn_lite_prepare_k(
    GM_ADDR qGMAddr, GM_ADDR kGMAddr, GM_ADDR gGMAddr, GM_ADDR betaGMAddr, GM_ADDR workspaceGMAddr,
    KDALite::KimiDeltaAttnLiteTilingData data)
{
    AscendC::InitSocState();
    KDALite::KernelProcessPrepareForAIC(data);
    KDALite::KernelProcessPrepareForAIV(
        reinterpret_cast<__gm__ bfloat16_t*>(qGMAddr), reinterpret_cast<__gm__ bfloat16_t*>(kGMAddr),
        reinterpret_cast<__gm__ float*>(gGMAddr), reinterpret_cast<__gm__ bfloat16_t*>(betaGMAddr),
        reinterpret_cast<__gm__ uint8_t*>(workspaceGMAddr), data);
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __mix__(1, 2) void kimi_delta_attn_lite_state_update_k(
    GM_ADDR valueGMAddr, GM_ADDR outputGMAddr, GM_ADDR finalStateGMAddr, GM_ADDR workspaceGMAddr,
    KDALite::KimiDeltaAttnLiteTilingData data)
{
    AscendC::InitSocState();
    if (data.statePipelineLaneCount == 1) {
        KDALite::SingleLane::KernelProcessStateUpdateForAIC(
            reinterpret_cast<__gm__ bfloat16_t*>(valueGMAddr), reinterpret_cast<__gm__ uint8_t*>(workspaceGMAddr),
            data);
        KDALite::SingleLane::KernelProcessStateUpdateForAIV(
            reinterpret_cast<__gm__ bfloat16_t*>(outputGMAddr), reinterpret_cast<__gm__ float*>(finalStateGMAddr),
            reinterpret_cast<__gm__ uint8_t*>(workspaceGMAddr), data);
    } else {
        KDALite::KernelProcessStateUpdateForAIC(
            reinterpret_cast<__gm__ bfloat16_t*>(valueGMAddr), reinterpret_cast<__gm__ uint8_t*>(workspaceGMAddr),
            data);
        KDALite::KernelProcessStateUpdateForAIV(
            reinterpret_cast<__gm__ bfloat16_t*>(outputGMAddr), reinterpret_cast<__gm__ float*>(finalStateGMAddr),
            reinterpret_cast<__gm__ uint8_t*>(workspaceGMAddr), data);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

void KDALite::LaunchKimiDeltaAttnLiteKernels(
    uint8_t* dQ, uint8_t* dK, uint8_t* dV, uint8_t* dLogDecay, uint8_t* dBeta, uint8_t* dO, uint8_t* dFinalState,
    uint8_t* dWorkspace, const KimiDeltaAttnLiteTilingData& data, void* stream)
{
    kimi_delta_attn_lite_prepare_k<<<data.prepareUseAicNum, 0, stream>>>(dQ, dK, dLogDecay, dBeta, dWorkspace, data);
    kimi_delta_attn_lite_state_update_k<<<data.stateUseAicNum, 0, stream>>>(dV, dO, dFinalState, dWorkspace, data);
}
