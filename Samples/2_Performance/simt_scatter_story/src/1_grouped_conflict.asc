 *
 * Step 1: conflict-safe grouped scatter. Only the last row in each destination group writes.
 */

#include "kernel_operator.h"
#include "sample_common.h"
#include "simt_api/asc_simt.h"

namespace {

using namespace SimtScatterStorySample;

__simt_vf__ LAUNCH_BOUND(SIMT_THREAD_NUM) inline void ScatterGroupedConflictSimt(
    int32_t coreId, int32_t coreNum, int32_t updateRows, int32_t dstRows, int32_t innerDim,
    __gm__ IndexType* indices, __gm__ DataType* updates, __gm__ DataType* y)
{
    auto tid = static_cast<int32_t>(AscendC::Simt::GetThreadIdx());
    auto threadNum = static_cast<int32_t>(AscendC::Simt::GetThreadNum());

    for (int32_t row = tid + coreId * threadNum; row < updateRows; row += coreNum * threadNum) {
        int32_t dst = indices[row];
        bool isLastInGroup = (row == updateRows - 1) || (dst != indices[row + 1]);
        if (!isLastInGroup || dst < 0 || dst >= dstRows) {
            continue;
        }
        int64_t srcOffset = static_cast<int64_t>(row) * innerDim;
        int64_t dstOffset = static_cast<int64_t>(dst) * innerDim;
        for (int32_t col = 0; col < innerDim; ++col) {
            y[dstOffset + col] = updates[srcOffset + col];
        }
    }
}

__global__ __aicore__ __vector__ void simt_scatter_grouped_conflict_kernel(
    __gm__ IndexType* indices, __gm__ DataType* updates, __gm__ DataType* y, int32_t updateRows, int32_t dstRows,
    int32_t innerDim)
{
    AscendC::InitSocState();
    int32_t coreId = static_cast<int32_t>(AscendC::GetBlockIdx());
    int32_t coreNum = static_cast<int32_t>(AscendC::GetBlockNum());
    AscendC::Simt::VF_CALL<ScatterGroupedConflictSimt>(
        AscendC::Simt::Dim3{SIMT_THREAD_NUM, 1, 1}, coreId, coreNum, updateRows, dstRows, innerDim, indices, updates, y);
    AscendC::PipeBarrier<PIPE_ALL>();
}

void LaunchScatterKernel(uint32_t blocks, aclrtStream stream, IndexType* indices, DataType* updates, DataType* y,
                         int32_t updateRows, int32_t dstRows, int32_t innerDim)
{
    simt_scatter_grouped_conflict_kernel<<<blocks, nullptr, stream>>>(indices, updates, y, updateRows, dstRows,
                                                                      innerDim);
}

} // namespace

int main()
{
    return SimtScatterStorySample::RunSample<1>(
        LaunchScatterKernel, "1_grouped_conflict", SimtScatterStorySample::ScatterDataCase::CONFLICT);
}
