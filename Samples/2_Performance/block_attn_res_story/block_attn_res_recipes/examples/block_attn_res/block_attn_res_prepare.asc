#include <cstdint>
#include <cstdlib>
#include <exception>
#include <iostream>
#include <memory>
#include <sstream>
#include <string>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "sample_common.h"
#include "kernel/block_attn_res_prepare_vector.h"

#include "kernel/block_attn_res_prepare_mix.h"

__global__ __vector__ void block_attn_res_prepare_vector_story_kernel(
    GM_ADDR blockRes, GM_ADDR validBlocks, GM_ADDR pseudoQuery, GM_ADDR numerator, GM_ADDR logitMax, GM_ADDR expSum,
    optiling::BlockAttnResPrepareTilingData tilingData)
{
    BlockAttnResPrepare::BlockAttnResPrepareVector op(&tilingData);
    op.Init(blockRes, validBlocks, pseudoQuery, numerator, logitMax, expSum);
    op.Process();
}

__global__ __mix__(1, 2) void block_attn_res_prepare_mix_story_kernel(
    GM_ADDR blockRes, GM_ADDR validBlocks, GM_ADDR pseudoQuery, GM_ADDR numerator, GM_ADDR logitMax, GM_ADDR expSum,
    GM_ADDR workspace, optiling::BlockAttnResPrepareMixTilingData tilingData)
{
    using KernelImpl = BlockAttnResPrepareMix::Attention::Kernel::KernelBlockAttnResPrepare;
    using Params = typename KernelImpl::Params;
    Params params{};
    params.problemShape = {
        static_cast<int64_t>(tilingData.totalS), static_cast<int64_t>(tilingData.totalN),
        static_cast<int64_t>(tilingData.totalD), static_cast<int64_t>(tilingData.totalT)};
    auto& mm1 = params.mm1Params;
    mm1.aGmAddr = pseudoQuery;
    mm1.bGmAddr = blockRes;
    mm1.cGmAddr = workspace;
    mm1.workspaceGmAddr = workspace;
    mm1.mL1 = tilingData.sAlign;
    mm1.nL1 = tilingData.mm1NAlign;
    mm1.kL1 = tilingData.baseDAlign;
    mm1.mL0 = tilingData.sAlign;
    mm1.nL0 = tilingData.mm1NAlign;
    mm1.kL0 = tilingData.baseD < 64U ? tilingData.baseD : 64U;
    mm1.l1Stages =
        tilingData.qL1BufferNum < tilingData.vL1BufferNum ? tilingData.qL1BufferNum : tilingData.vL1BufferNum;
    mm1.l0cStages = 1U;
    auto& mm2 = params.mm2Params;
    mm2.aGmAddr = workspace;
    mm2.bGmAddr = blockRes;
    mm2.cGmAddr = numerator;
    mm2.workspaceGmAddr = workspace;
    mm2.mL1 = tilingData.sAlign;
    mm2.nL1 = tilingData.baseDAlign;
    mm2.kL1 = tilingData.nAlign;
    mm2.mL0 = tilingData.sAlign;
    mm2.nL0 = tilingData.baseDAlign;
    mm2.kL0 = tilingData.nAlign;
    mm2.l1Stages = 1U;
    mm2.l0cStages = 1U;
    auto& epilogue = params.epilogueParams;
    epilogue.validBlocksGmAddr = validBlocks;
    epilogue.softmaxMaxGmAddr = logitMax;
    epilogue.weightedOutputGmAddr = numerator;
    epilogue.softmaxSumGmAddr = expSum;
    epilogue.workspaceGmAddr = workspace;
    epilogue.totalD = tilingData.totalD;
    epilogue.baseD = tilingData.baseD;
    epilogue.baseDAlign = tilingData.baseDAlign;
    epilogue.dTileNum = tilingData.dTileNum;
    epilogue.sAlign = tilingData.sAlign;
    epilogue.vUbBufferNum = tilingData.vUbBufferNum;
    epilogue.eWorkspaceElems = tilingData.eL1Elems;
    epilogue.vUbElems = tilingData.vUbElems;
    epilogue.dotUbElems = tilingData.dotUbElems;
    epilogue.reduceUbElems = tilingData.reduceUbElems;
    epilogue.softmaxUbElems = tilingData.softmaxUbElems;
    epilogue.workspacePerCoreElems = tilingData.workspacePerCoreElems;
    epilogue.epsilon = tilingData.eps;
    auto& scheduler = params.schedulerParams;
    scheduler.totalWorkUnits = tilingData.totalWorkUnits;
    scheduler.usedCoreNum = tilingData.usedCoreNum;
    scheduler.baseT = tilingData.baseT;
    scheduler.baseS = tilingData.baseS;
    scheduler.sTileNum = tilingData.sTileNum;
    scheduler.mm1NAlign = tilingData.mm1NAlign;
    {
        KernelImpl kernel;
        kernel(params);
    }
}

int main(int argc, char** argv)
{
    using namespace BlockAttnResStory;
    try {
        // Parse the shape and create the device context and tiling plans.
        const ShapeConfig shape = ParseArguments(argc, argv);
        AclContext context;
        const aclrtStream stream = context.Stream();
        const PlatformInfo platform = QueryPlatform();
        const PreparePlan preparePlan = BuildPreparePlan(shape, platform);
        std::cout << "shape: T=" << shape.t << " N=" << shape.n << " S=" << shape.s << " D=" << shape.d
                  << " validN=" << shape.validBlocks << " slot=" << shape.slot << std::endl;
        std::cout << "prepare template=" << (preparePlan.useMix ? "mix" : "vector")
                  << " blocks=" << preparePlan.blockDim << " workspace=" << preparePlan.workspaceBytes << " bytes"
                  << std::endl;

        // Host buffers. Owners below release each allocation on every exit path.
        float* queryHost = nullptr;
        float* blockResHost = nullptr;
        uint64_t* validHost = nullptr;
        float* numeratorOut = nullptr;
        float* maxOut = nullptr;
        float* sumOut = nullptr;

        // Device buffers.
        uint8_t* blockRes = nullptr;
        uint8_t* valid = nullptr;
        uint8_t* query = nullptr;
        uint8_t* prepareNumerator = nullptr;
        uint8_t* prepareMax = nullptr;
        uint8_t* prepareSum = nullptr;
        uint8_t* workspace = nullptr;

        // Generate inputs, allocate device buffers and upload the initial data.
        const std::string root = GetExeDir();
        std::ostringstream eps;
        eps << shape.eps;
        if (RunPython(
                {FindScript(root, "gen_data.py"), "--output", root, "--t", std::to_string(shape.t), "--n",
                 std::to_string(shape.n), "--s", std::to_string(shape.s), "--d", std::to_string(shape.d),
                 "--valid-blocks", std::to_string(shape.validBlocks), "--slot", std::to_string(shape.slot), "--eps",
                 eps.str()}) != 0)
            return 1;
        const uint64_t td = CheckedMul(shape.t, shape.d, "T*D");
        const size_t queryHostBytes = CheckedSize(CheckedMul(shape.s, shape.d, "S*D"), sizeof(float), "queryHost");
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&queryHost), queryHostBytes), "allocate Host queryHost");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> queryHostOwner(queryHost, aclrtFreeHost);
        ReadExactFile(root + "/input/pseudo_query.bin", queryHost, queryHostBytes);
        const size_t blockResHostBytes = CheckedSize(
            CheckedMul(CheckedMul(shape.t, shape.n, "T*N"), shape.d, "T*N*D"), sizeof(float), "blockResHost");
        CheckAcl(
            aclrtMallocHost(reinterpret_cast<void**>(&blockResHost), blockResHostBytes), "allocate Host blockResHost");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> blockResHostOwner(blockResHost, aclrtFreeHost);
        ReadExactFile(root + "/input/block_res.bin", blockResHost, blockResHostBytes);
        const size_t validHostBytes = CheckedSize(1, sizeof(uint64_t), "validHost");
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&validHost), validHostBytes), "allocate Host validHost");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> validHostOwner(validHost, aclrtFreeHost);
        ReadExactFile(root + "/input/valid_blocks.bin", validHost, validHostBytes);
        const size_t blockResBytes = blockResHostBytes;
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&blockRes), blockResBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "allocate blockRes");
        std::unique_ptr<void, decltype(&aclrtFree)> blockResOwner(blockRes, aclrtFree);
        const size_t validBytes = sizeof(uint64_t);
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&valid), validBytes, ACL_MEM_MALLOC_HUGE_FIRST), "allocate valid");
        std::unique_ptr<void, decltype(&aclrtFree)> validOwner(valid, aclrtFree);
        const size_t queryBytes = queryHostBytes;
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&query), queryBytes, ACL_MEM_MALLOC_HUGE_FIRST), "allocate query");
        std::unique_ptr<void, decltype(&aclrtFree)> queryOwner(query, aclrtFree);
        const size_t prepareNumeratorBytes = CheckedSize(CheckedMul(shape.s, td, "S*T*D"), sizeof(float), "numerator");
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&prepareNumerator), prepareNumeratorBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "allocate prepareNumerator");
        std::unique_ptr<void, decltype(&aclrtFree)> prepareNumeratorOwner(prepareNumerator, aclrtFree);
        const size_t prepareMaxBytes = CheckedSize(CheckedMul(shape.s, shape.t, "S*T"), sizeof(float), "max");
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&prepareMax), prepareMaxBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "allocate prepareMax");
        std::unique_ptr<void, decltype(&aclrtFree)> prepareMaxOwner(prepareMax, aclrtFree);
        const size_t prepareSumBytes = prepareMaxBytes;
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&prepareSum), prepareSumBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "allocate prepareSum");
        std::unique_ptr<void, decltype(&aclrtFree)> prepareSumOwner(prepareSum, aclrtFree);
        const size_t workspaceBytes = static_cast<size_t>(preparePlan.workspaceBytes);
        if (workspaceBytes != 0) {
            CheckAcl(
                aclrtMalloc(reinterpret_cast<void**>(&workspace), workspaceBytes, ACL_MEM_MALLOC_HUGE_FIRST),
                "allocate workspace");
        }
        std::unique_ptr<void, decltype(&aclrtFree)> workspaceOwner(workspace, aclrtFree);
        CheckAcl(
            aclrtMemcpyAsync(blockRes, blockResBytes, blockResHost, blockResBytes, ACL_MEMCPY_HOST_TO_DEVICE, stream),
            "upload blockRes");
        CheckAcl(
            aclrtMemcpyAsync(valid, validBytes, validHost, validBytes, ACL_MEMCPY_HOST_TO_DEVICE, stream),
            "upload valid");
        CheckAcl(
            aclrtMemcpyAsync(query, queryBytes, queryHost, queryBytes, ACL_MEMCPY_HOST_TO_DEVICE, stream),
            "upload query");

        // Enqueue warmup and repeat launches; synchronize after the complete task stream.
        const uint64_t runCount = static_cast<uint64_t>(shape.warmup) + shape.repeat;
        for (uint64_t i = 0; i < runCount; ++i) {
            if (preparePlan.useMix) {
                block_attn_res_prepare_mix_story_kernel<<<preparePlan.blockDim, nullptr, stream>>>(
                    blockRes, valid, query, prepareNumerator, prepareMax, prepareSum, workspace, preparePlan.mixData);
            } else {
                block_attn_res_prepare_vector_story_kernel<<<preparePlan.blockDim, nullptr, stream>>>(
                    blockRes, valid, query, prepareNumerator, prepareMax, prepareSum, preparePlan.vectorData);
            }
        }
        CheckAcl(aclrtSynchronizeStream(stream), "sample synchronize");

        // Copy results back, write output files and run the selected precision check.
        const size_t numeratorOutBytes =
            CheckedSize(static_cast<uint64_t>(shape.s) * td, sizeof(float), "numeratorOut");
        CheckAcl(
            aclrtMallocHost(reinterpret_cast<void**>(&numeratorOut), numeratorOutBytes), "allocate Host numeratorOut");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> numeratorOutOwner(numeratorOut, aclrtFreeHost);
        const size_t maxOutBytes = CheckedSize(static_cast<uint64_t>(shape.s) * shape.t, sizeof(float), "maxOut");
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&maxOut), maxOutBytes), "allocate Host maxOut");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> maxOutOwner(maxOut, aclrtFreeHost);
        const size_t sumOutBytes = CheckedSize(static_cast<uint64_t>(shape.s) * shape.t, sizeof(float), "sumOut");
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&sumOut), sumOutBytes), "allocate Host sumOut");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> sumOutOwner(sumOut, aclrtFreeHost);
        CheckAcl(
            aclrtMemcpyAsync(
                numeratorOut, prepareNumeratorBytes, prepareNumerator, prepareNumeratorBytes, ACL_MEMCPY_DEVICE_TO_HOST,
                stream),
            "download prepareNumerator");
        CheckAcl(
            aclrtMemcpyAsync(maxOut, prepareMaxBytes, prepareMax, prepareMaxBytes, ACL_MEMCPY_DEVICE_TO_HOST, stream),
            "download prepareMax");
        CheckAcl(
            aclrtMemcpyAsync(sumOut, prepareSumBytes, prepareSum, prepareSumBytes, ACL_MEMCPY_DEVICE_TO_HOST, stream),
            "download prepareSum");
        CheckAcl(aclrtSynchronizeStream(stream), "output synchronize");
        WriteFile(root + "/output/npu_prepare_numerator.bin", numeratorOut, numeratorOutBytes);
        WriteFile(root + "/output/npu_prepare_logit_max.bin", maxOut, maxOutBytes);
        WriteFile(root + "/output/npu_prepare_exp_sum.bin", sumOut, sumOutBytes);
        return RunPython(
            {FindScript(root, "verify_result.py"), "--root", root, "--mode", "prepare", "--t", std::to_string(shape.t),
             "--s", std::to_string(shape.s), "--d", std::to_string(shape.d), "--compare", shape.compareMethod});
    } catch (const std::exception& error) {
        std::cerr << "ERROR: " << error.what() << std::endl;
        return 1;
    }
}
