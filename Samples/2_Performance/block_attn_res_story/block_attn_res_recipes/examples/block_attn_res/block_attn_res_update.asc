#include <cstdint>
#include <cstdlib>
#include <exception>
#include <iostream>
#include <memory>
#include <sstream>
#include <string>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "sample_common.h"
#include "kernel/block_attn_res_update_full_d.h"

template <bool SINGLE_TILE>
__global__ __vector__ void block_attn_res_update_story_kernel(
    GM_ADDR partialBlock, GM_ADDR delta, GM_ADDR pseudoQuery, GM_ADDR numerator, GM_ADDR logitMax, GM_ADDR expSum,
    GM_ADDR h, BlockAttnResUpdateTilingData tilingData)
{
    {
        BlockAttnResUpdateOps::BlockAttnResUpdateFullD<SINGLE_TILE> op;
        op(partialBlock, delta, pseudoQuery, numerator, logitMax, expSum, h, &tilingData);
    }
}

int main(int argc, char** argv)
{
    using namespace BlockAttnResStory;
    try {
        // Parse the shape and create the device context and tiling plans.
        const ShapeConfig shape = ParseArguments(argc, argv);
        if (shape.validBlocks == 0) {
            throw std::invalid_argument("Update and E2E require a non-empty Prepare history state");
        }
        AclContext context;
        const aclrtStream stream = context.Stream();
        const PlatformInfo platform = QueryPlatform();
        const UpdatePlan updatePlan = BuildUpdatePlan(shape, platform);
        std::cout << "shape: T=" << shape.t << " N=" << shape.n << " S=" << shape.s << " D=" << shape.d
                  << " validN=" << shape.validBlocks << " slot=" << shape.slot << std::endl;
        std::cout << "update blocks=" << updatePlan.blockDim << " tileT=" << updatePlan.data.tileT
                  << " singleTile=" << updatePlan.singleTile << std::endl;

        // Host buffers. Owners below release each allocation on every exit path.
        float* queryHost = nullptr;
        float* partialHost = nullptr;
        uint16_t* deltaHost = nullptr;
        float* goldenNumerator = nullptr;
        float* goldenMax = nullptr;
        float* goldenSum = nullptr;
        float* partialOut = nullptr;
        uint16_t* hOut = nullptr;

        // Device buffers.
        uint8_t* partialInitial = nullptr;
        uint8_t* partial = nullptr;
        uint8_t* delta = nullptr;
        uint8_t* h = nullptr;
        uint8_t* standaloneQuery = nullptr;
        uint8_t* standaloneNumerator = nullptr;
        uint8_t* standaloneMax = nullptr;
        uint8_t* standaloneSum = nullptr;

        // Generate inputs, allocate device buffers and upload the initial data.
        const std::string root = GetExeDir();
        std::ostringstream eps;
        eps << shape.eps;
        if (RunPython(
                {FindScript(root, "gen_data.py"), "--output", root, "--t", std::to_string(shape.t), "--n",
                 std::to_string(shape.n), "--s", std::to_string(shape.s), "--d", std::to_string(shape.d),
                 "--valid-blocks", std::to_string(shape.validBlocks), "--slot", std::to_string(shape.slot), "--eps",
                 eps.str()}) != 0)
            return 1;
        const uint64_t td = CheckedMul(shape.t, shape.d, "T*D");
        const size_t queryHostBytes = CheckedSize(CheckedMul(shape.s, shape.d, "S*D"), sizeof(float), "queryHost");
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&queryHost), queryHostBytes), "allocate Host queryHost");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> queryHostOwner(queryHost, aclrtFreeHost);
        ReadExactFile(root + "/input/pseudo_query.bin", queryHost, queryHostBytes);
        const size_t partialHostBytes = CheckedSize(td, sizeof(float), "partialHost");
        CheckAcl(
            aclrtMallocHost(reinterpret_cast<void**>(&partialHost), partialHostBytes), "allocate Host partialHost");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> partialHostOwner(partialHost, aclrtFreeHost);
        ReadExactFile(root + "/input/partial_block.bin", partialHost, partialHostBytes);
        const size_t deltaHostBytes = CheckedSize(td, sizeof(uint16_t), "deltaHost");
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&deltaHost), deltaHostBytes), "allocate Host deltaHost");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> deltaHostOwner(deltaHost, aclrtFreeHost);
        ReadExactFile(root + "/input/delta.bin", deltaHost, deltaHostBytes);
        const size_t partialInitialBytes = CheckedSize(td, sizeof(float), "partial initial");
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&partialInitial), partialInitialBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "allocate partialInitial");
        std::unique_ptr<void, decltype(&aclrtFree)> partialInitialOwner(partialInitial, aclrtFree);
        const size_t partialBytes = partialInitialBytes;
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&partial), partialBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "allocate partial");
        std::unique_ptr<void, decltype(&aclrtFree)> partialOwner(partial, aclrtFree);
        const size_t deltaBytes = CheckedSize(td, sizeof(uint16_t), "delta");
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&delta), deltaBytes, ACL_MEM_MALLOC_HUGE_FIRST), "allocate delta");
        std::unique_ptr<void, decltype(&aclrtFree)> deltaOwner(delta, aclrtFree);
        const size_t hBytes = deltaBytes;
        CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&h), hBytes, ACL_MEM_MALLOC_HUGE_FIRST), "allocate h");
        std::unique_ptr<void, decltype(&aclrtFree)> hOwner(h, aclrtFree);
        CheckAcl(
            aclrtMemcpyAsync(
                partialInitial, partialInitialBytes, partialHost, partialInitialBytes, ACL_MEMCPY_HOST_TO_DEVICE,
                stream),
            "upload partialInitial");
        CheckAcl(
            aclrtMemcpyAsync(delta, deltaBytes, deltaHost, deltaBytes, ACL_MEMCPY_HOST_TO_DEVICE, stream),
            "upload delta");
        const size_t stateMatrixBytes = CheckedSize(td, sizeof(float), "slot numerator");
        const size_t stateVectorBytes = CheckedSize(shape.t, sizeof(float), "slot stats");

        // The standalone Update reads the selected slot from the Prepare reference outputs.
        const size_t queryBytes = CheckedSize(shape.d, sizeof(float), "slot query");
        const size_t standaloneQueryBytes = queryBytes;
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&standaloneQuery), standaloneQueryBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "allocate standaloneQuery");
        std::unique_ptr<void, decltype(&aclrtFree)> standaloneQueryOwner(standaloneQuery, aclrtFree);
        const size_t standaloneNumeratorBytes = stateMatrixBytes;
        CheckAcl(
            aclrtMalloc(
                reinterpret_cast<void**>(&standaloneNumerator), standaloneNumeratorBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "allocate standaloneNumerator");
        std::unique_ptr<void, decltype(&aclrtFree)> standaloneNumeratorOwner(standaloneNumerator, aclrtFree);
        const size_t standaloneMaxBytes = stateVectorBytes;
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&standaloneMax), standaloneMaxBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "allocate standaloneMax");
        std::unique_ptr<void, decltype(&aclrtFree)> standaloneMaxOwner(standaloneMax, aclrtFree);
        const size_t standaloneSumBytes = stateVectorBytes;
        CheckAcl(
            aclrtMalloc(reinterpret_cast<void**>(&standaloneSum), standaloneSumBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "allocate standaloneSum");
        std::unique_ptr<void, decltype(&aclrtFree)> standaloneSumOwner(standaloneSum, aclrtFree);
        const size_t goldenNumeratorBytes =
            CheckedSize(static_cast<uint64_t>(shape.s) * td, sizeof(float), "goldenNumerator");
        CheckAcl(
            aclrtMallocHost(reinterpret_cast<void**>(&goldenNumerator), goldenNumeratorBytes),
            "allocate Host goldenNumerator");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> goldenNumeratorOwner(goldenNumerator, aclrtFreeHost);
        ReadExactFile(root + "/output/golden_prepare_numerator.bin", goldenNumerator, goldenNumeratorBytes);
        const size_t goldenMaxBytes = CheckedSize(static_cast<uint64_t>(shape.s) * shape.t, sizeof(float), "goldenMax");
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&goldenMax), goldenMaxBytes), "allocate Host goldenMax");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> goldenMaxOwner(goldenMax, aclrtFreeHost);
        ReadExactFile(root + "/output/golden_prepare_logit_max.bin", goldenMax, goldenMaxBytes);
        const size_t goldenSumBytes = CheckedSize(static_cast<uint64_t>(shape.s) * shape.t, sizeof(float), "goldenSum");
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&goldenSum), goldenSumBytes), "allocate Host goldenSum");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> goldenSumOwner(goldenSum, aclrtFreeHost);
        ReadExactFile(root + "/output/golden_prepare_exp_sum.bin", goldenSum, goldenSumBytes);
        CheckAcl(
            aclrtMemcpyAsync(
                standaloneNumerator, stateMatrixBytes, goldenNumerator + static_cast<uint64_t>(shape.slot) * td,
                stateMatrixBytes, ACL_MEMCPY_HOST_TO_DEVICE, stream),
            "copy slot numerator");
        CheckAcl(
            aclrtMemcpyAsync(
                standaloneMax, stateVectorBytes, goldenMax + static_cast<uint64_t>(shape.slot) * shape.t,
                stateVectorBytes, ACL_MEMCPY_HOST_TO_DEVICE, stream),
            "copy slot max");
        CheckAcl(
            aclrtMemcpyAsync(
                standaloneSum, stateVectorBytes, goldenSum + static_cast<uint64_t>(shape.slot) * shape.t,
                stateVectorBytes, ACL_MEMCPY_HOST_TO_DEVICE, stream),
            "copy slot sum");
        CheckAcl(
            aclrtMemcpyAsync(
                standaloneQuery, queryBytes, queryHost + static_cast<uint64_t>(shape.slot) * shape.d, queryBytes,
                ACL_MEMCPY_HOST_TO_DEVICE, stream),
            "copy slot query");

        // Enqueue warmup and repeat launches; synchronize after the complete task stream.
        const uint64_t runCount = static_cast<uint64_t>(shape.warmup) + shape.repeat;
        for (uint64_t i = 0; i < runCount; ++i) {
            // Reset the in-place input on the launch stream before each Update.
            CheckAcl(
                aclrtMemcpyAsync(
                    partial, partialBytes, partialInitial, partialInitialBytes, ACL_MEMCPY_DEVICE_TO_DEVICE, stream),
                "reset partial D2D memcpy async");
            if (updatePlan.singleTile) {
                block_attn_res_update_story_kernel<true><<<updatePlan.blockDim, nullptr, stream>>>(
                    partial, delta, standaloneQuery, standaloneNumerator, standaloneMax, standaloneSum, h,
                    updatePlan.data);
            } else {
                block_attn_res_update_story_kernel<false><<<updatePlan.blockDim, nullptr, stream>>>(
                    partial, delta, standaloneQuery, standaloneNumerator, standaloneMax, standaloneSum, h,
                    updatePlan.data);
            }
        }
        CheckAcl(aclrtSynchronizeStream(stream), "sample synchronize");

        // Copy results back, write output files and run the selected precision check.
        const size_t partialOutBytes = CheckedSize(td, sizeof(float), "partialOut");
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&partialOut), partialOutBytes), "allocate Host partialOut");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> partialOutOwner(partialOut, aclrtFreeHost);
        const size_t hOutBytes = CheckedSize(td, sizeof(uint16_t), "hOut");
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&hOut), hOutBytes), "allocate Host hOut");
        std::unique_ptr<void, decltype(&aclrtFreeHost)> hOutOwner(hOut, aclrtFreeHost);
        CheckAcl(
            aclrtMemcpyAsync(partialOut, partialBytes, partial, partialBytes, ACL_MEMCPY_DEVICE_TO_HOST, stream),
            "download partial");
        CheckAcl(aclrtMemcpyAsync(hOut, hBytes, h, hBytes, ACL_MEMCPY_DEVICE_TO_HOST, stream), "download h");
        CheckAcl(aclrtSynchronizeStream(stream), "output synchronize");
        WriteFile(root + "/output/npu_update_partial.bin", partialOut, partialOutBytes);
        WriteFile(root + "/output/npu_update_h.bin", hOut, hOutBytes);
        return RunPython(
            {FindScript(root, "verify_result.py"), "--root", root, "--mode", "update", "--t", std::to_string(shape.t),
             "--s", std::to_string(shape.s), "--d", std::to_string(shape.d), "--compare", shape.compareMethod});
    } catch (const std::exception& error) {
        std::cerr << "ERROR: " << error.what() << std::endl;
        return 1;
    }
}
