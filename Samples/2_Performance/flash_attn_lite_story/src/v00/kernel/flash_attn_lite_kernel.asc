#include "falite_kernel_aic.h"
#include "falite_kernel_aiv.h"

template <bool CAUSAL_MASK>
__global__ __mix__(1, 2) void flash_attn_lite_k(
    GM_ADDR qGMAddr, GM_ADDR kGMAddr, GM_ADDR vGMAddr, GM_ADDR sGMAddr, GM_ADDR pGMAddr, GM_ADDR deltaOGMAddr,
    GM_ADDR outGMAddr, FALite::FlashAttnLiteTilingData data)
{
    // 显式构造 LocalTensor 前先初始化 AI Core 状态.
    AscendC::InitSocState();
    FALite::KernelProcessForAIC<CAUSAL_MASK>(
        reinterpret_cast<__gm__ bfloat16_t*>(qGMAddr), reinterpret_cast<__gm__ bfloat16_t*>(kGMAddr),
        reinterpret_cast<__gm__ bfloat16_t*>(vGMAddr), reinterpret_cast<__gm__ float*>(sGMAddr),
        reinterpret_cast<__gm__ bfloat16_t*>(pGMAddr), reinterpret_cast<__gm__ float*>(deltaOGMAddr), data);
    FALite::KernelProcessForAIV<CAUSAL_MASK>(
        reinterpret_cast<__gm__ float*>(sGMAddr), reinterpret_cast<__gm__ bfloat16_t*>(pGMAddr),
        reinterpret_cast<__gm__ float*>(deltaOGMAddr), reinterpret_cast<__gm__ bfloat16_t*>(outGMAddr), data);
}

void FALite::LaunchFlashAttnLiteKernel(
    uint8_t* dQ, uint8_t* dK, uint8_t* dV, uint8_t* dS, uint8_t* dP, uint8_t* dDeltaO, uint8_t* dOut,
    const FALite::FlashAttnLiteTilingData& data, void* stream)
{
    // v00 固定发射一个 Mix 核组，并使用因果模板实例。
    flash_attn_lite_k<true><<<1, 0, stream>>>(dQ, dK, dV, dS, dP, dDeltaO, dOut, data);
}
