#include "falite_kernel_aic.h"
#include "falite_kernel_aiv.h"

__global__ __mix__(1, 2) void flash_attn_lite_k(
    GM_ADDR qGMAddr, GM_ADDR kGMAddr, GM_ADDR vGMAddr, GM_ADDR pGMAddr, GM_ADDR outGMAddr,
    FALite::FlashAttnLiteTilingData data)
{
    AscendC::InitSocState();
    FALite::KernelProcessForAIC(
        reinterpret_cast<__gm__ bfloat16_t*>(qGMAddr), reinterpret_cast<__gm__ bfloat16_t*>(kGMAddr),
        reinterpret_cast<__gm__ bfloat16_t*>(vGMAddr), reinterpret_cast<__gm__ bfloat16_t*>(pGMAddr), data);
    FALite::KernelProcessForAIV(
        reinterpret_cast<__gm__ bfloat16_t*>(pGMAddr), reinterpret_cast<__gm__ bfloat16_t*>(outGMAddr), data);
    AscendC::PipeBarrier<PIPE_ALL>();
}

void FALite::LaunchFlashAttnLiteKernel(
    uint8_t* dQ, uint8_t* dK, uint8_t* dV, uint8_t* dP, uint8_t* dOut, const FALite::FlashAttnLiteTilingData& data,
    void* stream)
{
    flash_attn_lite_k<<<data.useAicNum, 0, stream>>>(dQ, dK, dV, dP, dOut, data);
}
