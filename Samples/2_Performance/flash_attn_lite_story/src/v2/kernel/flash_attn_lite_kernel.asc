#include "falite_kernel_aic.h"
#include "falite_kernel_aiv.h"

__global__ __mix__(1, 2) void flash_attn_lite_k(
    GM_ADDR qGMAddr, GM_ADDR kGMAddr, GM_ADDR vGMAddr, GM_ADDR outGMAddr, FALite::FlashAttnLiteTilingData data)
{
    // 显式构造 LocalTensor 前先初始化 AI Core 状态.
    AscendC::InitSocState();
    FALite::KernelProcessForAIC(
        reinterpret_cast<__gm__ bfloat16_t*>(qGMAddr), reinterpret_cast<__gm__ bfloat16_t*>(kGMAddr),
        reinterpret_cast<__gm__ bfloat16_t*>(vGMAddr), data);
    FALite::KernelProcessForAIV(reinterpret_cast<__gm__ bfloat16_t*>(outGMAddr), data);
    // Kernel 退出前排空全部硬件流水.
    AscendC::PipeBarrier<PIPE_ALL>();
}

void FALite::LaunchFlashAttnLiteKernel(
    uint8_t* dQ, uint8_t* dK, uint8_t* dV, uint8_t* dOut, const FALite::FlashAttnLiteTilingData& data, void* stream)
{
    flash_attn_lite_k<<<data.useAicNum, 0, stream>>>(dQ, dK, dV, dOut, data);
}
