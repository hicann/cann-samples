 *
 * Case 1: 基础 SIMT 并行 - 标量 grid-stride 读 GM + asc_atomic_add 在 UB 处理冲突。
 */

#include "sample_common.h"

#include "simt_api/device_sync_functions.h"
#include "simt_api/device_atomic_functions.h"

namespace {

using namespace SimtHistogramStorySample;

constexpr int32_t ALIGNED_NUM = 8;
constexpr int32_t WARPS_PER_BLOCK = SIMT_THREADS_PER_BLOCK / WARP_SIZE;  // 1024 / 32 = 32

__global__ void simt_histogram_basic_simt_kernel(
    XType* x, XType* min, XType* max, OutType* y, int32_t totalLength, int32_t bins)
{
    // ================================================================
    // 初始化：SIMT 线程组织
    // ================================================================
    // Case 0: InitSocState → GetBlockIdx/GetBlockNum → 手动计算数据段
    // Case 1: blockIdx.x / gridDim.x - SIMT 内置变量，无需 InitSocState
    int32_t tid = threadIdx.x;
    int32_t blockThreads = blockDim.x;
    int32_t totalThreads = gridDim.x * blockDim.x;
    int32_t globalTid = blockIdx.x * blockDim.x + threadIdx.x;

    // Warp 级隔离：warpId 决定写入哪份 Warp 直方图，laneId 用于并行清零
    int32_t warpId = tid / WARP_SIZE;
    int32_t laneId = tid % WARP_SIZE;

    // ================================================================
    // 读取 min / max 值
    // ================================================================
    // Case 0: DataCopyPad(tile→UB) → SetFlag/WaitFlag(MTE2_S) → GetValue
    // Case 1: GM 直接读，所有线程读同地址
    float minVal = *min;
    float maxVal = *max;
    if (minVal == maxVal) {
        minVal = minVal - 1.0f;
        maxVal = maxVal + 1.0f;
    }
    float range = maxVal - minVal;
    float binsF = static_cast<float>(bins);

    // ================================================================
    // 分配直方图缓冲区并清零
    // ================================================================
    // Case 0: yQue.AllocTensor → Duplicate → SetFlag/WaitFlag(V_S)
    // Case 1: __ubuf__[][] 静态数组 → 每 Warp 独立，laneId 跨步清零
    constexpr int32_t PADDED_BINS = BINS + ALIGNED_NUM;
    __ubuf__ OutType warpHistos[WARPS_PER_BLOCK][PADDED_BINS];

    for (int32_t w = 0; w < WARPS_PER_BLOCK; w++) {
        for (int32_t i = laneId; i < PADDED_BINS; i += WARP_SIZE) {
            warpHistos[w][i] = 0;
        }
    }
    asc_syncthreads();

    // ================================================================
    // 读取输入并更新直方图
    // ================================================================
    // Case 0: DataCopyPad 双缓冲 tile→UB + Scalar 串行
    // Case 1: 标量逐元素 grid-stride 跨步读 GM，每个线程只更新自己 Warp 的直方图
    for (int32_t i = globalTid; i < totalLength; i += totalThreads) {
        float val = x[i];
        if (val >= minVal && val <= maxVal) {
            int32_t idx = static_cast<int32_t>((val - minVal) * binsF / range);
            if (idx == bins) idx = bins - 1;
            asc_atomic_add(warpHistos[warpId] + idx, 1);
        }
    }
    asc_syncthreads();

    // ================================================================
    // 合并 Warp 直方图 → 归约到 GM
    // ================================================================
    // Case 0: SetAtomicAdd + DataCopyPad（通过 MTE 将 yLocal 原子写回 yGm）
    // Case 1: 多线程并行合并 Warp 直方图，再 asc_atomic_add 写 GM
    for (int32_t i = tid; i < bins; i += blockThreads) {
        OutType sum = 0;
        for (int32_t w = 0; w < WARPS_PER_BLOCK; w++) {
            sum += warpHistos[w][i];
        }
        asc_atomic_add(y + i, sum);
    }
}

void LaunchHistogramKernel(uint32_t blocks, aclrtStream stream, XType* x, XType* min, XType* max, OutType* y,
                           int32_t totalLength, int32_t bins)
{
    // Case 0: <<<blocks, nullptr, stream>>>
    // Case 1: <<<grid, block, dynUB, stream>>>
    simt_histogram_basic_simt_kernel<<<blocks, SIMT_THREADS_PER_BLOCK, 0, stream>>>(
        x, min, max, y, totalLength, bins);
}

} // namespace

int main()
{
    return SimtHistogramStorySample::RunSample<1>(
        LaunchHistogramKernel, "1_basic_simt", SimtHistogramStorySample::HistogramDataCase::UNIFORM);
}
