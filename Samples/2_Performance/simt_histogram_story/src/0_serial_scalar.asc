 * Case 0: 串行/标量基线 - 传统 Ascend C MTE+Vector 实现。
 */

#include "kernel_operator.h"
#include "sample_common.h"

namespace {

using namespace AscendC;
using namespace SimtHistogramStorySample;

// --- 常量定义 ---
constexpr int32_t TILE_DATA_LENGTH = 16383;  // 每个 tile 容纳 16383 个 float（65532B ≤ uint16_t max 65535）
constexpr int32_t DOUBLE_BUFFER = 2;          // 双缓冲：MTE 搬 tile N 与 Scalar 算 tile N-1 重叠
constexpr int32_t ALIGNED_NUM = 8;            // 32B 对齐（8 × 4 bytes）

__global__ __aicore__ void simt_histogram_serial_scalar_kernel(
    __gm__ XType* x, __gm__ XType* min, __gm__ XType* max, __gm__ OutType* y, int32_t totalLength, int32_t bins)
{
    // ================================================================
    // 初始化
    // ================================================================
    AscendC::InitSocState();
    int32_t coreId = static_cast<int32_t>(AscendC::GetBlockIdx());
    int32_t coreNum = static_cast<int32_t>(AscendC::GetBlockNum());

    // 将裸 GM 指针包装为 GlobalTensor，支持带偏移量的数组式访问
    GlobalTensor<XType> xGm;
    GlobalTensor<XType> minGm;
    GlobalTensor<XType> maxGm;
    GlobalTensor<OutType> yGm;
    xGm.SetGlobalBuffer(x, totalLength);
    minGm.SetGlobalBuffer(min, 1);
    maxGm.SetGlobalBuffer(max, 1);
    yGm.SetGlobalBuffer(y, bins);

    // 创建流水线管理器（TPipe）与各队列
    TPipe tpipe;
    TQue<TPosition::VECIN, DOUBLE_BUFFER> xQue;   // 双缓冲输入队列：MTE 搬入 → Scalar 消费
    TQue<TPosition::VECIN, 1> minQue;              // min 值搬运队列
    TQue<TPosition::VECIN, 1> maxQue;              // max 值搬运队列
    TQue<TPosition::VECOUT, 1> yQue;               // 输出队列：管理直方图 buffer

    tpipe.InitBuffer(xQue, DOUBLE_BUFFER, TILE_DATA_LENGTH * sizeof(XType));
    tpipe.InitBuffer(minQue, 1, sizeof(XType));
    tpipe.InitBuffer(maxQue, 1, sizeof(XType));
    tpipe.InitBuffer(yQue, 1, (bins + ALIGNED_NUM) * sizeof(OutType));

    // ================================================================
    // 读取 min / max 值 → UB
    // ================================================================
    LocalTensor<XType> minLocal = minQue.AllocTensor<XType>();
    LocalTensor<XType> maxLocal = maxQue.AllocTensor<XType>();

    {
        DataCopyParams cpMin{1, static_cast<uint16_t>(sizeof(XType)), 0, 0};
        DataCopyPadParams pad{true, 0, 0, 0};
        DataCopyPad(minLocal, minGm, cpMin, pad);
    }
    {
        DataCopyParams cpMax{1, static_cast<uint16_t>(sizeof(XType)), 0, 0};
        DataCopyPadParams pad{true, 0, 0, 0};
        DataCopyPad(maxLocal, maxGm, cpMax, pad);
    }

    // 等待 MTE 搬运完成（MTE2 → Scalar 同步）
    {
        event_t evMte = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_S));
        SetFlag<HardEvent::MTE2_S>(evMte);
        WaitFlag<HardEvent::MTE2_S>(evMte);
    }

    XType minVal = minLocal.GetValue(0);
    XType maxVal = maxLocal.GetValue(0);

    minQue.FreeTensor(minLocal);
    maxQue.FreeTensor(maxLocal);

    // 处理 min == max 边界情况（避免除零）
    if (minVal == maxVal) {
        minVal = minVal - 1;
        maxVal = maxVal + 1;
    }
    XType minMaxRange = maxVal - minVal;

    // ================================================================
    // 多核切分 - 每个 core 处理自己分到的数据段
    // ================================================================
    // 数据切分：前 formerNum 个 core 处理 formerLength 个元素，
    //          最后一个 core 处理 tailLength 个元素
    int64_t formerLength = totalLength / coreNum;
    int64_t formerNum = (totalLength % coreNum == 0) ? coreNum : coreNum - 1;
    int64_t tailLength = totalLength - formerNum * formerLength;

    int64_t coreDataLength;       // 本 core 处理的元素总数
    int64_t coreDataStart;        // 本 core 在 x 中的起始偏移
    if (coreId < formerNum) {
        coreDataLength = formerLength;
        coreDataStart = coreId * formerLength;
    } else {
        // 注意：此例中 totalLength=1M, coreNum=4 恰好整除，不会进入此分支
        coreDataLength = tailLength;
        coreDataStart = formerNum * formerLength + (coreId - formerNum) * tailLength;
    }

    // ================================================================
    // 在 UB 上分配本地直方图缓冲区并清零
    // ================================================================
    LocalTensor<OutType> yLocal = yQue.AllocTensor<OutType>();
    Duplicate<OutType>(yLocal, 0, bins + ALIGNED_NUM);

    // 等待 Vector 的 Duplicate 指令执行完毕（Vector → Scalar 同步）
    {
        event_t evV = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
        SetFlag<HardEvent::V_S>(evV);
        WaitFlag<HardEvent::V_S>(evV);
    }

    // ================================================================
    // 分 tile 处理本 core 的数据段（双缓冲流水）
    // ================================================================
    //
    // 双缓冲原理：
    //   xQue 有 2 个 buffer slot（buf0 / buf1）
    //   - CopyIn:  MTE 将 GM 的一个 tile 搬运到空闲 slot → EnQue[slot]
    //   - Compute: DeQue → Scalar 取值计算直方图 → FreeTensor[slot]
    //
    // 流水线示意（MTE 与 Scalar 重叠）：
    //   时间 →
    //   MTE:    [搬 tile0→buf0] [搬 tile1→buf1] [搬 tile2→buf0] ...
    //   Scalar:                 [算 buf0]        [算 buf1]       ...
    //

    int64_t tileNum = coreDataLength / TILE_DATA_LENGTH;
    int64_t tailLen = coreDataLength - tileNum * TILE_DATA_LENGTH;

    for (int64_t t = 0; t < tileNum; t++) {
        // --- CopyIn: MTE 搬运第 t 个 tile 到 UB ---
        LocalTensor<XType> xLocal = xQue.AllocTensor<XType>();
        {
            DataCopyParams cp{1, static_cast<uint16_t>(TILE_DATA_LENGTH * sizeof(XType)), 0, 0};
            DataCopyPadParams pad{true, 0, 0, 0};
            DataCopyPad(xLocal, xGm[coreDataStart + t * TILE_DATA_LENGTH], cp, pad);
        }
        xQue.EnQue(xLocal);

        // --- Compute: DeQue → 串行逐元素计算 → FreeTensor ---
        xLocal = xQue.DeQue<XType>();
        for (int32_t i = 0; i < TILE_DATA_LENGTH; i++) {
            XType val = xLocal.GetValue(i);
            if (val >= minVal && val <= maxVal) {
                // 计算该元素落入的 bin 索引
                int32_t idx = static_cast<int32_t>(static_cast<float>(val - minVal) * bins / minMaxRange);
                if (idx == bins) {
                    idx = bins - 1;  // max 精确值归入最后一个 bin
                }
                yLocal.SetValue(idx, yLocal.GetValue(idx) + 1);
            }
        }
        xQue.FreeTensor(xLocal);
    }

    // --- 尾部处理（不足一个完整 tile 的部分） ---
    if (tailLen > 0) {
        LocalTensor<XType> xLocal = xQue.AllocTensor<XType>();
        {
            DataCopyParams cp{1, static_cast<uint16_t>(tailLen * sizeof(XType)), 0, 0};
            DataCopyPadParams pad{true, 0, 0, 0};
            DataCopyPad(xLocal, xGm[coreDataStart + tileNum * TILE_DATA_LENGTH], cp, pad);
        }
        xQue.EnQue(xLocal);

        xLocal = xQue.DeQue<XType>();
        for (int64_t i = 0; i < tailLen; i++) {
            XType val = xLocal.GetValue(i);
            if (val >= minVal && val <= maxVal) {
                int32_t idx = static_cast<int32_t>(static_cast<float>(val - minVal) * bins / minMaxRange);
                if (idx == bins) {
                    idx = bins - 1;
                }
                yLocal.SetValue(idx, yLocal.GetValue(idx) + 1);
            }
        }
        xQue.FreeTensor(xLocal);
    }

    // ================================================================
    // 将本地直方图通过 atomic_add 归约到 GM
    // ================================================================
    // 多核场景：每个 core 有自己独立的本地直方图 yLocal，
    // 所有 core 通过 SetAtomicAdd + DataCopyPad 将计数原子累加到 yGm
    {
        DataCopyParams cpOut{1, static_cast<uint16_t>(bins * sizeof(OutType)), 0, 0};
        SetAtomicAdd<OutType>();
        DataCopyPad(yGm, yLocal, cpOut);
        SetAtomicNone();
    }
    yQue.FreeTensor(yLocal);

    // --- 流水线收尾：等待所有硬件队列操作完毕 ---
    AscendC::PipeBarrier<PIPE_ALL>();
}

void LaunchHistogramKernel(uint32_t blocks, aclrtStream stream, XType* x, XType* min, XType* max, OutType* y,
                           int32_t totalLength, int32_t bins)
{
    simt_histogram_serial_scalar_kernel<<<blocks, nullptr, stream>>>(x, min, max, y, totalLength, bins);
}

} // namespace

int main()
{
    // 多核串行基线：4 个 block 并⾏执⾏，各 core 处理 1/4 数据，
    // 最后通过 SetAtomicAdd 归约到 GM
    return SimtHistogramStorySample::RunSample<0>(
        LaunchHistogramKernel, "0_serial_scalar", SimtHistogramStorySample::HistogramDataCase::UNIFORM);
}
