 * INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
 * See LICENSE in the root of the software repository for the full text of the License.
 *
 * Step 2: Binary fold（chunk 轴）—— "把 reduce 拆成 2 条独立链"思想的起源，本样例非最优。
 *
 * y = softmax(x, axis=-1) = exp(x - max(x)) / sum(exp(x - max(x)))
 *
 * 思路：reduce 的 Max/Add 是跨迭代依赖的串行归约（latency-bound）。把一行的 8 个 chunk
 * 按 even/odd 拆成 2 条独立累加链（maxEven/maxOdd），各自累积一半，末尾再合并 1 次。
 * 两条链互不依赖，硬件双发把它们叠掉，关键路径 8→5。sum 同理（pairwise summation）。
 *
 * 收益与边界：单行 vs Case 1 收益 -2.1%（N=2048 / 8 chunk，串行步数 8→5，方差大）。但它不能叠在
 * Case 3（多行并行）之上——2 行已把双发打满，再 even/odd 拆 4 链无延迟可藏，实测 +5% 回退。
 * 同一思想搬到 row 轴（直接拿 row0/row1 当 2 链）就能砍掉合并那拍 + 摊销 VF 调用，即
 * Case 3（多行并行，第五节），严格强于本 Case。
 */

#include "kernel_operator.h"
#include "sample_common.h"

namespace {

constexpr float NEG_INF_F = -3.4028235e+38f;

// Pass 1: 2 行并�?ReduceMax
__simd_vf__ inline void VfReduceMax1RowBF(
    __ubuf__ float* xAddr0, __ubuf__ float* scalarAddr,
    uint32_t rowStride, uint32_t n, uint16_t loopNum, uint16_t oneRepeatSize)
{
    AscendC::Reg::MaskReg fullMask =
        AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::MaskReg mask;
    AscendC::Reg::RegTensor<float> xReg0, maxEven0, maxOdd0, tempReg;
    AscendC::Reg::UnalignRegForStore unalignAcc;

    AscendC::Reg::Duplicate(maxEven0, NEG_INF_F);
    AscendC::Reg::Duplicate(maxOdd0, NEG_INF_F);
    uint32_t n1 = n;
    uint16_t pairs = loopNum / 2;
    for (uint16_t i = 0; i < pairs; ++i) {
        mask = AscendC::Reg::UpdateMask<float>(n1);
        AscendC::Reg::LoadAlign(xReg0, xAddr0 + (2 * i) * oneRepeatSize);
        AscendC::Reg::Max<float, AscendC::Reg::MaskMergeMode::MERGING>(maxEven0, maxEven0, xReg0, mask);
        AscendC::Reg::LoadAlign(xReg0, xAddr0 + (2 * i + 1) * oneRepeatSize);
        AscendC::Reg::Max<float, AscendC::Reg::MaskMergeMode::MERGING>(maxOdd0, maxOdd0, xReg0, mask);
    }
    if (loopNum & 1) {
        mask = AscendC::Reg::UpdateMask<float>(n1);
        AscendC::Reg::LoadAlign(xReg0, xAddr0 + (2 * pairs) * oneRepeatSize);
        AscendC::Reg::Max<float, AscendC::Reg::MaskMergeMode::MERGING>(maxEven0, maxEven0, xReg0, mask);
    }
    AscendC::Reg::Max<float, AscendC::Reg::MaskMergeMode::MERGING>(maxEven0, maxEven0, maxOdd0, fullMask);
    AscendC::Reg::ReduceMax(tempReg, maxEven0, fullMask);
    __ubuf__ float* storeAddr = scalarAddr;
    AscendC::Reg::StoreUnAlign(storeAddr, tempReg, unalignAcc, 1);
    AscendC::Reg::StoreUnAlignPost(storeAddr, unalignAcc, 0);
}

// Pass 2: 2 行并�?Sub + Exp + ReduceSum
__simd_vf__ inline void VfSubExpSum1RowBF(
    __ubuf__ float* xAddr0, __ubuf__ float* yAddr0, __ubuf__ float* scalarAddr,
    uint32_t rowStride, uint32_t n, uint16_t loopNum, uint16_t oneRepeatSize)
{
    AscendC::Reg::MaskReg fullMask =
        AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    AscendC::Reg::MaskReg mask;
    AscendC::Reg::RegTensor<float> xReg0, maxReg0, sumEven0, sumOdd0, tempReg;
    AscendC::Reg::UnalignRegForStore unalignAcc;

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_BRC_B32>(maxReg0, scalarAddr + 0);
    AscendC::Reg::Duplicate(sumEven0, 0.0f);
    AscendC::Reg::Duplicate(sumOdd0, 0.0f);
    uint32_t n2 = n;
    uint16_t pairs = loopNum / 2;
    for (uint16_t i = 0; i < pairs; ++i) {
        mask = AscendC::Reg::UpdateMask<float>(n2);
        AscendC::Reg::LoadAlign(xReg0, xAddr0 + (2 * i) * oneRepeatSize);
        AscendC::Reg::Sub(xReg0, xReg0, maxReg0, mask);
        AscendC::Reg::Exp(xReg0, xReg0, mask);
        AscendC::Reg::StoreAlign(yAddr0 + (2 * i) * oneRepeatSize, xReg0, mask);
        AscendC::Reg::Add<float, AscendC::Reg::MaskMergeMode::MERGING>(sumEven0, sumEven0, xReg0, mask);
        AscendC::Reg::LoadAlign(xReg0, xAddr0 + (2 * i + 1) * oneRepeatSize);
        AscendC::Reg::Sub(xReg0, xReg0, maxReg0, mask);
        AscendC::Reg::Exp(xReg0, xReg0, mask);
        AscendC::Reg::StoreAlign(yAddr0 + (2 * i + 1) * oneRepeatSize, xReg0, mask);
        AscendC::Reg::Add<float, AscendC::Reg::MaskMergeMode::MERGING>(sumOdd0, sumOdd0, xReg0, mask);
    }
    if (loopNum & 1) {
        mask = AscendC::Reg::UpdateMask<float>(n2);
        AscendC::Reg::LoadAlign(xReg0, xAddr0 + (2 * pairs) * oneRepeatSize);
        AscendC::Reg::Sub(xReg0, xReg0, maxReg0, mask);
        AscendC::Reg::Exp(xReg0, xReg0, mask);
        AscendC::Reg::StoreAlign(yAddr0 + (2 * pairs) * oneRepeatSize, xReg0, mask);
        AscendC::Reg::Add<float, AscendC::Reg::MaskMergeMode::MERGING>(sumEven0, sumEven0, xReg0, mask);
    }
    AscendC::Reg::Add<float, AscendC::Reg::MaskMergeMode::MERGING>(sumEven0, sumEven0, sumOdd0, fullMask);
    AscendC::Reg::ReduceSum(tempReg, sumEven0, fullMask);
    __ubuf__ float* storeAddr = scalarAddr;
    AscendC::Reg::StoreUnAlign(storeAddr, tempReg, unalignAcc, 1);
    AscendC::Reg::StoreUnAlignPost(storeAddr, unalignAcc, 0);
}

// Pass 3: 2 行并�?Div
__simd_vf__ inline void VfDiv1Row(
    __ubuf__ float* yAddr0, __ubuf__ float* scalarAddr,
    uint32_t n, uint16_t loopNum, uint16_t oneRepeatSize)
{
    AscendC::Reg::MaskReg mask;
    AscendC::Reg::RegTensor<float> yReg0, sumReg0;

    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_BRC_B32>(sumReg0, scalarAddr + 0);
    uint32_t n3 = n;
    for (uint16_t i = 0; i < loopNum; ++i) {
        mask = AscendC::Reg::UpdateMask<float>(n3);
        AscendC::Reg::LoadAlign(yReg0, yAddr0 + i * oneRepeatSize);
        AscendC::Reg::Div(yReg0, yReg0, sumReg0, mask);
        AscendC::Reg::StoreAlign(yAddr0 + i * oneRepeatSize, yReg0, mask);
    }
}

template <uint32_t totalM, uint32_t totalN, uint32_t singleCoreM, uint32_t singleCoreN, uint32_t tileLen>
class KernelSoftmaxBinaryFold {
public:
    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y)
    {
        AscendC::InitSocState();
        xGm.SetGlobalBuffer((__gm__ float*)x);
        yGm.SetGlobalBuffer((__gm__ float*)y);
        InitGMOffsets();
    }

    __aicore__ inline void InitGMOffsets()
    {
        uint32_t blockIdx = AscendC::GetBlockIdx();
        constexpr uint32_t mIndex = (totalM + singleCoreM - 1) / singleCoreM;
        constexpr uint32_t nIndex = (totalN + singleCoreN - 1) / singleCoreN;
        constexpr uint32_t tailM = totalM - (mIndex - 1) * singleCoreM;
        constexpr uint32_t tailN = totalN - (nIndex - 1) * singleCoreN;

        uint32_t mIdx = blockIdx % mIndex;
        uint32_t nIdx = blockIdx / mIndex;
        actualSingleCoreM = (mIdx == mIndex - 1) ? tailM : singleCoreM;
        actualSingleCoreN = (nIdx == nIndex - 1) ? tailN : singleCoreN;

        uint64_t off = mIdx * singleCoreM * totalN + nIdx * singleCoreN;
        xGm = xGm[off];
        yGm = yGm[off];
    }

    __aicore__ inline void ComputeRegBase1Row(
        const AscendC::LocalTensor<float>& xRow0,
        const AscendC::LocalTensor<float>& yRow0,
        const AscendC::LocalTensor<float>& scalarBuf,
        uint32_t n)
    {
        constexpr uint16_t oneRepeatSize = AscendC::GetVecLen() / sizeof(float);
        uint16_t loopNum = static_cast<uint16_t>(AscendC::CeilDivision(n, oneRepeatSize));
        __ubuf__ float* xAddr0 = (__ubuf__ float*)xRow0.GetPhyAddr();
        __ubuf__ float* yAddr0 = (__ubuf__ float*)yRow0.GetPhyAddr();
        __ubuf__ float* scalarAddr = (__ubuf__ float*)scalarBuf.GetPhyAddr();
        asc_vf_call<VfReduceMax1RowBF>(xAddr0, scalarAddr, n, n, loopNum, oneRepeatSize);
        asc_vf_call<VfSubExpSum1RowBF>(xAddr0, yAddr0, scalarAddr, n, n, loopNum, oneRepeatSize);
        asc_vf_call<VfDiv1Row>(yAddr0, scalarAddr, n, loopNum, oneRepeatSize);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<float> xPing(AscendC::TPosition::VECCALC, ubXPing, tileLen);
        AscendC::LocalTensor<float> yPing(AscendC::TPosition::VECCALC, ubYPing, tileLen);
        AscendC::LocalTensor<float> xPong(AscendC::TPosition::VECCALC, ubXPong, tileLen);
        AscendC::LocalTensor<float> yPong(AscendC::TPosition::VECCALC, ubYPong, tileLen);
        AscendC::LocalTensor<float> scalarBuf(AscendC::TPosition::VECCALC, ubScalar, 16);

        constexpr uint32_t tileRow = tileLen / singleCoreN;
        uint32_t tiles = (actualSingleCoreM + tileRow - 1) / tileRow;
        uint32_t tailRow = actualSingleCoreM - (tiles - 1) * tileRow;

        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);

        for (uint32_t t = 0; t < tiles; ++t) {
            uint32_t rows = (t == tiles - 1) ? tailRow : tileRow;
            int32_t ev = (t & 1) ? EVENT_ID1 : EVENT_ID0;
            AscendC::LocalTensor<float>& xLocal = (t & 1) ? xPong : xPing;
            AscendC::LocalTensor<float>& yLocal = (t & 1) ? yPong : yPing;

            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(ev);

            uint32_t blockLen = actualSingleCoreN * sizeof(float);
            uint32_t srcStride = (totalN - actualSingleCoreN) * sizeof(float);
            AscendC::DataCopyExtParams cpIn = {static_cast<uint16_t>(rows), blockLen, srcStride, 0, 0};
            AscendC::DataCopyPadExtParams<float> pad = {false, 0, 0, 0};
            AscendC::DataCopyPad<float>(xLocal, xGm[t * tileRow * totalN], cpIn, pad);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ev);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ev);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(ev);

            uint32_t xBase = (t & 1) ? ubXPong : ubXPing;
            uint32_t yBase = (t & 1) ? ubYPong : ubYPing;
            for (uint32_t row = 0; row < rows; ++row) {
                uint32_t rowByteOff0 = row * actualSingleCoreN * sizeof(float);
                AscendC::LocalTensor<float> xRow0(AscendC::TPosition::VECCALC,
                    xBase + rowByteOff0, actualSingleCoreN);
                AscendC::LocalTensor<float> yRow0(AscendC::TPosition::VECCALC,
                    yBase + rowByteOff0, actualSingleCoreN);
                ComputeRegBase1Row(xRow0, yRow0, scalarBuf, actualSingleCoreN);
            }

            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(ev);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(ev);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(ev);

            AscendC::DataCopyExtParams cpOut = {static_cast<uint16_t>(rows), blockLen, 0, srcStride, 0};
            AscendC::DataCopyPad<float>(yGm[t * tileRow * totalN], yLocal, cpOut);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(ev);
        }

        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID1);
    }

private:
    static constexpr uint32_t ubXPing = 0;
    static constexpr uint32_t ubXPong = tileLen * sizeof(float);
    static constexpr uint32_t ubYPing = ubXPong + tileLen * sizeof(float);
    static constexpr uint32_t ubYPong = ubYPing + tileLen * sizeof(float);
    static constexpr uint32_t ubScalar = ubYPong + tileLen * sizeof(float);

    AscendC::GlobalTensor<float> xGm;
    AscendC::GlobalTensor<float> yGm;
    uint32_t actualSingleCoreM;
    uint32_t actualSingleCoreN;
};

using KernelOp = KernelSoftmaxBinaryFold<
    SoftmaxRegbaseSample::TOTAL_M, SoftmaxRegbaseSample::TOTAL_N,
    SoftmaxRegbaseSample::SINGLE_CORE_M, SoftmaxRegbaseSample::SINGLE_CORE_N,
    SoftmaxRegbaseSample::TILE_LEN>;

__global__ __vector__ void softmax_regbase_kernel(__gm__ uint8_t* x, __gm__ uint8_t* y)
{
    KernelOp op;
    op.Init(x, y);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

void LaunchSoftmaxKernel(uint32_t blocks, aclrtStream stream, uint8_t* x, uint8_t* y)
{
    softmax_regbase_kernel<<<blocks, nullptr, stream>>>(x, y);
}

} // namespace

int main()
{
    return SoftmaxRegbaseSample::RunSample<2>(LaunchSoftmaxKernel, "2_binary_fold");
}
